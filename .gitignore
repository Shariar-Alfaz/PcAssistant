## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
/publish/
/out/
/dist/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/
.DS_Store
Thumbs.db

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Visual Studio / Rider / JetBrains
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
_ReSharper*/
*.DotSettings.user

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# .NET MAUI / mobile packaging
*.apk
*.aab
*.ipa
*.app
*.appx
*.appxbundle
*.msix
*.msixbundle
*.pfx
*.keystore
*.jks
*.mobileprovision
*.cer
*.p12

# FastAPI / Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
pip-wheel-metadata/
*.egg-info/

# PyInstaller backend packaging output
src/pcAssistantApi/.pyinstaller/
src/pcAssistantApi/build/
src/pcAssistantApi/dist/
src/pcAssistantApi/*.spec

# Generated companion API payload copied into the MAUI Windows app by the
# FastAPI PyInstaller build script.
src/PcAssistant/PcAssistant/Platforms/Windows/Api/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local
appsettings.Development.json
appsettings.*.local.json

# Tooling caches
.cache/
.parcel-cache/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
