{
  "private": true,
  "scripts": {
    "build:assets": "npm run tailwind:build && npm run bundle:assets",
    "bundle:assets": "node ./scripts/bundle-assets.mjs",
    "tailwind:build": "tailwindcss -i ./src/PcAssistant/PcAssistant/Styles/tailwind.css -o ./src/PcAssistant/PcAssistant/wwwroot/css/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/PcAssistant/PcAssistant/Styles/tailwind.css -o ./src/PcAssistant/PcAssistant/wwwroot/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.11"
  },
  "dependencies": {
    "sortablejs": "^1.15.7"
  }
}
