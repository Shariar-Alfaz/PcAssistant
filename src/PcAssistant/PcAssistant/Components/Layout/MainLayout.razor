@inherits LayoutComponentBase

<main class="@RootClass">
    @Body
</main>

@code {
    private bool _isDarkMode;

    private string RootClass => _isDarkMode
        ? "dark h-screen overflow-hidden bg-[#1f1f1f] text-neutral-100"
        : "h-screen overflow-hidden bg-[#f7f7f7] text-slate-950";

    private string ThemeLabel => _isDarkMode ? "Dark" : "Light";

    private string ThemeToggleTitle => _isDarkMode ? "Switch to light mode" : "Switch to dark mode";

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }
}
