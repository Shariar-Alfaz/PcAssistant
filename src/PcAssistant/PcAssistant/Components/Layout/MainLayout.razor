@inherits LayoutComponentBase
@inject PcAssistant.Application.Abstractions.Services.IAiApiProcessService AiApiProcess
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<div class="@RootClass">
    <div class="pc-app-background" aria-hidden="true">
        <span class="pc-bg-grid"></span>
        <span class="pc-bg-sweep"></span>
        <span class="pc-bg-circuit pc-bg-circuit-a"></span>
        <span class="pc-bg-circuit pc-bg-circuit-b"></span>
        <span class="pc-bg-signal pc-bg-signal-a"></span>
        <span class="pc-bg-signal pc-bg-signal-b"></span>
    </div>
    <NavMenu />
    <main class="pc-app-main min-h-0 min-w-0 overflow-hidden">
        @Body
    </main>
</div>

@if (_isStartingAiApi)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-[#080b16] px-6 text-center text-[#d9e2f1]">
        <section class="flex flex-col items-center">
            <div class="flex flex-col items-center">
                <img class="size-16 rounded-2xl border border-white/10 shadow-2xl shadow-black/25" src="images/appicon.png" alt="PcAssistant" />
                <span class="mt-4 block h-1 w-24 overflow-hidden rounded-full bg-[#17263c]">
                    <span class="block h-full w-1/2 animate-pulse rounded-full bg-[#8ec5ff]"></span>
                </span>
            </div>
            <h1 class="mt-5 text-2xl font-semibold tracking-normal text-white">PcAssistant</h1>
            <p class="mt-2 text-sm text-[#aab6c9]">Starting AI service.</p>
        </section>
    </div>
}

@code {
    private const string RootClass = "pc-app-shell grid h-screen min-h-0 grid-cols-[auto_minmax(0,1fr)] overflow-hidden bg-[#080b16] text-slate-950";
    private bool _isStartingAiApi = true;
    private bool _hasStartedAiApi;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _hasStartedAiApi)
        {
            return;
        }

        _hasStartedAiApi = true;
        _ = JsRuntime.InvokeVoidAsync("pcAssistantBackground.initialize");
        _ = StartAiApiAsync();
    }

    private async Task StartAiApiAsync()
    {
        try
        {
            await AiApiProcess.StartAsync();
        }
        catch
        {
            // Keep the UI available even if the bundled API cannot start.
        }
        finally
        {
            _isStartingAiApi = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("pcAssistantBackground.destroy");
        }
        catch
        {
            // The WebView can already be gone while the layout is disposing.
        }

        await AiApiProcess.StopAsync();
    }
}
