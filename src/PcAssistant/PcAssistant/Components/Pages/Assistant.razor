    private void ClearDirectorySuggestions()
    {
        _directorySuggestions.Clear();
        _selectedDirectoryIndex = -1;
        _showDirectorySuggestions = false;
    }

    private void OnPendingPathInput(ChangeEventArgs args)
    {
        _pendingPathText = args.Value?.ToString() ?? string.Empty;
        RefreshPendingPath();
    }

    private void RefreshPendingPath()
    {
        if (_pendingCommand is null || !CanEditPendingPath)
        {
            return;
        }

        var validation = SafetyValidator.ValidateFileSystemTarget(_pendingPathText);
        var targetPath = validation.ResolvedPath ?? _pendingPathText.Trim();
        var isBlocked = !validation.IsAllowed || string.IsNullOrWhiteSpace(validation.ResolvedPath);
        _pendingPathError = isBlocked ? validation.Message ?? "The folder path is blocked." : null;
        _pendingCommand = CreateEditedPathCommand(_pendingCommand, targetPath, isBlocked, _pendingPathError);
    }

    private static ParsedCommand CreateEditedPathCommand(
        ParsedCommand command,
        string targetPath,
        bool isBlocked,
        string? errorMessage)
    {
        return new ParsedCommand
        {
            CommandLabel = command.CommandLabel,
            OriginalText = command.OriginalText,
            FolderName = string.IsNullOrWhiteSpace(targetPath) ? command.FolderName : Path.GetFileName(targetPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)),
            LocationAlias = command.LocationAlias,
            LocationType = command.LocationType,
            PathText = targetPath,
            ResolvedPath = string.IsNullOrWhiteSpace(targetPath) ? null : targetPath,
            RequiresConfirmation = command.RequiresConfirmation,
            IsDangerous = isBlocked,
            Preview = isBlocked
                ? errorMessage ?? "The folder path is blocked."
                : BuildPathPreview(command.CommandLabel, targetPath),
            ErrorMessage = isBlocked ? errorMessage : null,
        };
    }

    private static string BuildPathPreview(string commandLabel, string targetPath)
    {
        return commandLabel == "filesystem.delete_folder"
            ? $"Delete folder: {targetPath}"
            : $"Create folder: {targetPath}";
    }

    private static string BuildPendingAssistantMessage(ParsedCommand command)
    {
        if (command.IsDangerous)
        {
            return command.ErrorMessage ?? "This command was blocked for safety.";
        }

        return command.RequiresConfirmation
            ? $"Please confirm before running. {command.Preview}"
            : command.Preview;
    }

    private static string BuildPredictionMessage(CommandResponse response, ParsedCommand parsed)
    {
        if (response.Confidence < 0.60 || parsed.CommandLabel == "unknown")
        {
            return "I could not understand this as a PC command. Please rephrase it.";
        }

        if (parsed.IsDangerous)
        {
            return parsed.ErrorMessage ?? "This command was blocked for safety.";
        }

        if (response.Confidence < 0.80)
        {
            return $"Low confidence prediction. Please confirm before running. {parsed.Preview}";
        }

        return parsed.RequiresConfirmation
            ? $"Please confirm before running. {parsed.Preview}"
            : parsed.Preview;
    }

    private static string FormatConfidence(double confidence)
    {
        return $"{confidence:P0}";
    }

    private static string ConfidenceClass(double confidence)
    {
        if (confidence < 0.60)
        {
            return "rounded-full bg-rose-100 px-2 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-400/[0.12] dark:text-rose-200";
        }

        if (confidence < 0.80)
        {
            return "rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-400/[0.12] dark:text-amber-200";
        }

        return "rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-400/[0.12] dark:text-emerald-200";
    }

    public void Dispose()
    {
        _directoryPickerReference?.Dispose();
    }

    private void ReplaceHistoryItem(AssistantHistoryItem item)
    {
        var index = _history.FindIndex(existingItem => existingItem.Id == item.Id);
        if (index >= 0)
        {
            _history[index] = item;
            return;
        }

        _history.Add(item);
    }

