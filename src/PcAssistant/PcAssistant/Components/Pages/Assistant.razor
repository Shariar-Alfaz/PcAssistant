@page "/assistant"
@page "/"
@inject ICommandAiClient AiClient
@inject ICommandParserService Parser
@inject IWindowsCommandExecutor Executor
@inject ICommandHistoryService CommandHistory
@inject IDirectorySuggestionService DirectorySuggestions
@inject ILocationPickerService LocationPicker
@inject ICommandSafetyValidator SafetyValidator
@inject IScheduledTaskService ScheduledTasks
@inject IJSRuntime JsRuntime
@using PcAssistant.Application.Abstractions.Services
@using PcAssistant.Domain.Entity
@implements IDisposable

<PageTitle>Assistant</PageTitle>

<section class="@ShellClass">
    <aside class="@SidebarClass">
        <div class="flex items-center justify-between px-2">
            <a class="@SidebarBrandClass" href="">PcAssistant</a>
            <button class="flex size-8 items-center justify-center rounded-lg text-[#c9d2e3] transition hover:bg-white/10"
                    type="button"
                    title="@SidebarToggleTitle"
                    @onclick="ToggleSidebar">
                <svg class="@SidebarToggleIconClass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 5h14v14H5V5Zm5 0v14" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
            </button>
        </div>

        <nav class="mt-7 space-y-2">
            <button class="copilot-nav-item w-full"
                    type="button"
                    @onclick="NewChatAsync">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2Zm0 14H5.17L4 17.17V4h16v12Zm-9-2h2v-3h3V9h-3V6h-2v3H8v2h3v3Z" />
                </svg>
                <span class="@SidebarTextClass">New chat</span>
            </button>
            <a class="copilot-nav-item w-full"
               href="automation">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 4.5v3m10-3v3M5.5 10h13M6 6h12a1.5 1.5 0 0 1 1.5 1.5v10A1.5 1.5 0 0 1 18 19H6a1.5 1.5 0 0 1-1.5-1.5v-10A1.5 1.5 0 0 1 6 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="m9 14 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">Automation</span>
            </a>
        </nav>

        <div class="@SidebarFullOnlyClass">
            <div class="mt-5 h-px bg-white/18"></div>

            <div class="mt-4 min-h-0 flex-1 overflow-y-auto pr-1">
                @if (_isLoadingChats)
                {
                    <p class="px-2 py-2 text-sm text-[#9da8ba]">Loading chats...</p>
                }
                else if (_chats.Count == 0)
                {
                    <p class="px-2 py-2 text-sm text-[#9da8ba]">No chats yet.</p>
                }
                else
                {
                    @foreach (var chat in _chats)
                    {
                        <div class="@ChatRowClass(chat.Id)">
                            <button class="min-w-0 flex-1 truncate text-left"
                                    type="button"
                                    title="@chat.Title"
                                    @onclick="() => SelectChatAsync(chat.Id)">
                                @chat.Title
                            </button>
                            <button class="flex size-7 shrink-0 items-center justify-center rounded-md text-[#9da8ba] opacity-0 transition group-hover:opacity-100 hover:bg-white/10 hover:text-rose-200"
                                    type="button"
                                    title="Delete chat"
                                    @onclick="() => RequestDeleteChat(chat.Id)">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M6 7h12m-9 0V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m-7 0 .7 12h6.6L16 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="@SidebarProfileClass">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#33415f] text-sm font-semibold text-white">S</span>
            <span class="@SidebarProfileTextClass">
                <span class="block truncate text-sm font-semibold text-white">Shariar</span>
                <span class="block truncate text-xs text-[#a8b2c4]">Local assistant</span>
            </span>
        </div>
    </aside>

    <main class="pc-chat-surface relative h-screen min-h-0 min-w-0 overflow-hidden">
        <div class="pc-chat-background" aria-hidden="true">
            <span class="pc-bg-grid"></span>
            <span class="pc-bg-sweep"></span>
            <span class="pc-bg-circuit pc-bg-circuit-a"></span>
            <span class="pc-bg-circuit pc-bg-circuit-b"></span>
            <span class="pc-bg-signal pc-bg-signal-a"></span>
            <span class="pc-bg-signal pc-bg-signal-b"></span>
        </div>
        <div class="pc-chat-surface-shade absolute inset-0"></div>
        <div class="relative z-10 flex h-screen min-h-0 flex-col px-5 py-4 sm:px-8">
            @if (_isLoadingChats)
            {
                <section class="mx-auto flex w-full max-w-3xl flex-1 flex-col items-center justify-center text-center">
                    <div class="flex size-16 items-center justify-center rounded-2xl border border-white/10 bg-[#121c31]/90 shadow-2xl shadow-black/20">
                        <span class="size-7 animate-spin rounded-full border-2 border-[#8ec5ff]/25 border-t-[#dce9ff]"></span>
                    </div>
                    <h1 class="mt-5 text-2xl font-semibold tracking-normal text-white">Loading PcAssistant</h1>
                    <p class="mt-2 text-sm leading-6 text-[#aab6c9]">Preparing command history and scheduled tasks.</p>
                </section>
            }
            else if (_history.Count == 0 && !_isLoadingSelectedChat)
            {
                <section class="mx-auto flex w-full max-w-5xl flex-1 flex-col items-center pt-12 text-center">
                    <h1 class="text-3xl font-semibold tracking-normal text-white sm:text-4xl">Nice to see you, Shariar. What's new?</h1>
                    @ScheduledTaskQueuePanel()

                    <div class="mt-9 w-full max-w-[46.5rem] rounded-[1.85rem] border border-[#263653] bg-[#121c31] p-4 text-left ring-2 shadow-[0_22px_65px_rgba(0,0,0,0.28)] ring-[#22314d]">
                        <div class="relative min-w-0">
                            @ComposerInput("text-base", "Message PcAssistant")
                            @if (HasInlinePath(_input))
                            {
                                <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                                    @HighlightCommandPaths(_input)
                                </p>
                            }

                            @if (ShowDirectorySuggestions)
                            {
                                <div class="absolute top-full right-0 left-0 z-30 mt-3 overflow-hidden rounded-2xl border border-white/10 bg-[#111b2e] shadow-2xl shadow-black/40">
                                    <div class="border-b border-white/10 px-3 py-2 text-xs font-semibold text-[#aab6c9]">@_directorySuggestionTitle</div>
                                    <div class="max-h-64 overflow-y-auto p-1">
                                        @for (var index = 0; index < _directorySuggestions.Count; index++)
                                        {
                                            var suggestionIndex = index;
                                            var suggestion = _directorySuggestions[index];
                                            <button class="@DirectorySuggestionClass(index)"
                                                    type="button"
                                                    @onmousedown:preventDefault
                                                    @onclick="() => SelectDirectorySuggestionAsync(suggestionIndex)">
                                                <span class="flex min-w-0 items-start gap-2">
                                                    <span class="@DirectorySuggestionIconClass(suggestion.Kind)" aria-hidden="true">@DirectoryIcon(suggestion.Kind)</span>
                                                    <span class="min-w-0">
                                                        <span class="block truncate text-xs font-bold">@suggestion.DisplayName</span>
                                                        <span class="block truncate font-mono text-[0.68rem] opacity-75">@DirectorySuggestionPathText(suggestion)</span>
                                                    </span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3 flex justify-end">
                            <button class="rounded-full bg-[#d6dfef] px-4 py-2 text-sm font-semibold text-[#101827] transition hover:bg-white disabled:cursor-not-allowed disabled:bg-[#41506d] disabled:text-[#aab6c9]"
                                    type="button"
                                    disabled="@IsSendDisabled"
                                    @onclick="SendAsync">
                                @(_isBusy ? "Thinking..." : "Send")
                            </button>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <section class="mx-auto flex w-full max-w-4xl flex-1 flex-col overflow-hidden py-8">
                    <div class="mb-5 flex items-center justify-between">
                        <h1 class="truncate text-xl font-semibold text-white">@ActiveChatTitle</h1>
                        <span class="rounded-full border border-emerald-300/25 bg-emerald-300/10 px-3 py-1 text-xs font-semibold text-emerald-100">Protected execution</span>
                    </div>
                    @ScheduledTaskQueuePanel()

                    <div @ref="_messageListElement"
                         class="min-h-0 flex-1 space-y-5 overflow-y-auto pr-2"
                         @onscroll="OnMessageListScrollAsync">
                        @if (_isLoadingSelectedChat)
                        {
                            @ChatHistorySkeleton()
                        }
                        else
                        {
                            @if (_isLoadingOlderMessages)
                            {
                                @OlderMessagesSkeleton()
                            }

                            @foreach (var item in _history)
                            {
                                @ChatHistoryTurn(item)
                            }
                        }
                    </div>

                    @if (_pendingCommand is not null)
                    {
                        <section class="@PanelClass">
                            <h2 class="text-base font-semibold">@PanelTitle</h2>
                            <p class="mt-3 text-sm leading-6 [overflow-wrap:anywhere]">@PanelMessage</p>

                            @if (CanEditPendingPath)
                            {
                                <label class="mt-4 block text-xs font-bold tracking-[0.16em] uppercase opacity-75" for="pending-path">Target path</label>
                                <input id="pending-path"
                                       class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-black/20 px-3 font-mono text-xs text-white outline-none focus:border-[#8ec5ff] focus:ring-4 focus:ring-[#8ec5ff]/10"
                                       value="@_pendingPathText"
                                       @oninput="OnPendingPathInput"
                                       disabled="@_isExecuting" />
                            }

                            @if (CanEditPendingRestart)
                            {
                                <div class="mt-4 max-w-xs">
                                    <label class="block text-xs font-bold tracking-[0.16em] uppercase opacity-75" for="pending-restart-delay">Restart delay</label>
                                    <div class="mt-2 flex items-center gap-2">
                                        <input id="pending-restart-delay"
                                               class="min-h-11 w-28 rounded-xl border border-white/10 bg-black/20 px-3 text-sm font-semibold text-white outline-none focus:border-[#8ec5ff] focus:ring-4 focus:ring-[#8ec5ff]/10"
                                               type="number"
                                               min="1"
                                               max="86400"
                                               step="1"
                                               value="@_pendingRestartDelaySeconds"
                                               @oninput="OnPendingRestartDelayInput"
                                               disabled="@_isExecuting" />
                                        <span class="text-sm font-semibold opacity-80">seconds</span>
                                    </div>
                                </div>
                            }

                            @if (CanExecutePendingCommand)
                            {
                                <div class="mt-4 flex gap-3">
                                    <button class="rounded-xl bg-[#dce9ff] px-4 py-2 text-sm font-semibold text-[#0b1427] transition hover:bg-white disabled:bg-white/20 disabled:text-[#aab6c9]"
                                            disabled="@_isExecuting"
                                            @onclick="RequestCommandConfirmation">@(_isExecuting ? "Running..." : "Confirm")</button>
                                    <button class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10 disabled:opacity-60"
                                            disabled="@_isExecuting"
                                            @onclick="CancelPending">Cancel</button>
                                </div>
                            }
                        </section>
                    }

                    <div class="mt-5 rounded-[1.5rem] border border-[#263653] bg-[#121c31] p-4 shadow-[0_18px_50px_rgba(0,0,0,0.24)]">
                        <div class="flex flex-col gap-3 sm:flex-row">
                            <div class="relative min-w-0 flex-1">
                                @ComposerInput("text-sm", CommandInputPlaceholder)
                                @if (HasInlinePath(_input))
                                {
                                    <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                                        @HighlightCommandPaths(_input)
                                    </p>
                                }
                                @if (ShowDirectorySuggestions)
                                {
                                    <div class="absolute right-0 bottom-full left-0 z-30 mb-2 overflow-hidden rounded-2xl border border-white/10 bg-[#111b2e] shadow-2xl shadow-black/40">
                                        <div class="border-b border-white/10 px-3 py-2 text-xs font-semibold text-[#aab6c9]">@_directorySuggestionTitle</div>
                                        <div class="max-h-64 overflow-y-auto p-1">
                                            @for (var index = 0; index < _directorySuggestions.Count; index++)
                                            {
                                                var suggestionIndex = index;
                                                var suggestion = _directorySuggestions[index];
                                                <button class="@DirectorySuggestionClass(index)"
                                                        type="button"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectDirectorySuggestionAsync(suggestionIndex)">
                                                    <span class="flex min-w-0 items-start gap-2">
                                                        <span class="@DirectorySuggestionIconClass(suggestion.Kind)" aria-hidden="true">@DirectoryIcon(suggestion.Kind)</span>
                                                        <span class="min-w-0">
                                                            <span class="block truncate text-xs font-bold">@suggestion.DisplayName</span>
                                                            <span class="block truncate font-mono text-[0.68rem] opacity-75">@DirectorySuggestionPathText(suggestion)</span>
                                                        </span>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <button class="min-h-12 rounded-2xl bg-[#dce9ff] px-6 text-sm font-semibold text-[#0b1427] transition hover:bg-white disabled:cursor-not-allowed disabled:bg-[#41506d] disabled:text-[#aab6c9]"
                                    disabled="@IsSendDisabled"
                                    @onclick="SendAsync">@(_isBusy ? "Thinking..." : "Send")</button>
                        </div>
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p class="absolute right-6 bottom-6 left-6 z-20 rounded-xl border border-rose-300/20 bg-rose-950/80 px-3 py-2 text-sm text-rose-100">@_errorMessage</p>
            }
        </div>
    </main>

    @if (_chatPendingDeletion is not null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 backdrop-blur-sm">
            <section class="w-full max-w-md rounded-[1.5rem] border border-white/10 bg-[#101827] p-5 text-[#d9e2f1] shadow-2xl shadow-black/40">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-rose-400/15 text-rose-200">
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 7h12m-9 0V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m-7 0 .7 12h6.6L16 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Delete chat history?</h2>
                        <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                            This will remove <span class="font-semibold text-white">@_chatPendingDeletion.Title</span> and its saved messages from this device.
                        </p>
                    </div>
                </div>
                <div class="mt-5 flex justify-end gap-3">
                    <button class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                            type="button"
                            disabled="@_isDeletingChat"
                            @onclick="CancelDeleteChat">
                        Cancel
                    </button>
                    <button class="rounded-xl bg-rose-400 px-4 py-2 text-sm font-semibold text-[#21080d] transition hover:bg-rose-300 disabled:bg-rose-400/40"
                            type="button"
                            disabled="@_isDeletingChat"
                            @onclick="ConfirmDeleteChatAsync">
                        @(_isDeletingChat ? "Deleting..." : "Delete")
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showCommandConfirmationModal && _pendingCommand is not null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 backdrop-blur-sm">
            <section class="w-full max-w-lg rounded-[1.5rem] border border-white/10 bg-[#101827] p-5 text-[#d9e2f1] shadow-2xl shadow-black/40">
                <div class="flex items-start gap-3">
                    <span class="@CommandConfirmationIconClass">
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 9v4m0 4h.01M10.3 4.7 2.9 17.5A1.7 1.7 0 0 0 4.4 20h15.2a1.7 1.7 0 0 0 1.5-2.5L13.7 4.7a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">@CommandConfirmationTitle</h2>
                        <p class="mt-2 text-sm leading-6 text-[#aab6c9]">@CommandConfirmationMessage</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_pendingCommand.ResolvedPath))
                {
                    <p class="mt-4 max-w-full rounded-xl bg-black/30 px-3 py-2 font-mono text-xs leading-5 text-[#d9e2f1] [overflow-wrap:anywhere]">
                        @_pendingCommand.ResolvedPath
                    </p>
                }

                <div class="mt-5 flex justify-end gap-3">
                    <button class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                            type="button"
                            disabled="@_isExecuting"
                            @onclick="CancelCommandConfirmation">
                        Cancel
                    </button>
                    <button class="@CommandConfirmationButtonClass"
                            type="button"
                            disabled="@_isExecuting"
                            @onclick="ConfirmCommandFromModalAsync">
                        @(_isExecuting ? "Running..." : CommandConfirmationButtonText)
                    </button>
                </div>
            </section>
        </div>
    }
</section>

@code {
    private const string CommandInputId = "assistant-command-input";
    private const string PickLocationKind = "action-pick-location";
    private const int ChatMessagePageSize = 30;
    private static readonly TimeSpan RestartScheduleDelay = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan MaximumRestartScheduleDelay = TimeSpan.FromHours(24);

    private readonly List<AssistantHistoryItem> _history = new();
    private readonly List<ChatSessionSummary> _chats = new();
    private readonly List<ScheduledTaskItem> _scheduledTasks = new();
    private readonly List<DirectorySuggestion> _directorySuggestions = new();
    private readonly List<DirectorySuggestion> _selectedDirectories = new();
    private static readonly DirectorySuggestion PickLocationSuggestion = new(string.Empty, "Pick a location", PickLocationKind);
    private static readonly System.Text.RegularExpressions.Regex InlinePathRegex = new(
        @"(?<path>[A-Za-z]:[\\/][^\s,;]*)",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private string _input = string.Empty;
    private string _pathTailInput = string.Empty;
    private string _pendingPathText = string.Empty;
    private string? _pendingPathError;
    private int _pendingRestartDelaySeconds = (int)RestartScheduleDelay.TotalSeconds;
    private bool _isBusy;
    private bool _isExecuting;
    private string? _errorMessage;
    private CommandResponse? _lastResponse;
    private ParsedCommand? _pendingCommand;
    private Guid? _pendingCommandLogId;
    private string _effectiveLabel = "unknown";
    private bool _lowConfidenceRequiresConfirmation;
    private int _selectedDirectoryIndex = -1;
    private bool _showDirectorySuggestions;
    private bool _isLoadingChats = true;
    private bool _isDeletingChat;
    private bool _showCommandConfirmationModal;
    private bool _isSidebarCollapsed;
    private bool _focusCommandInputAfterRender;
    private bool _isRefreshingScheduledTasks;
    private bool _isLoadingSelectedChat;
    private bool _isLoadingOlderMessages;
    private bool _hasOlderMessages;
    private bool _scrollMessagesToBottomAfterRender;
    private bool _restoreOlderMessageScrollAfterRender;
    private Guid? _activeChatId;
    private Guid? _loadingChatId;
    private Guid? _cancellingScheduledTaskId;
    private DateTimeOffset? _oldestLoadedMessageCreatedAtUtc;
    private double _olderMessageScrollHeightBeforeLoad;
    private ChatSessionSummary? _chatPendingDeletion;
    private string _directorySuggestionTitle = "Directories";
    private ElementReference _messageListElement;
    private DotNetObjectReference<Assistant>? _directoryPickerReference;
    private System.Threading.Timer? _scheduledTaskTimer;

    [SupplyParameterFromQuery(Name = "chatId")]
    public Guid? RequestedChatId { get; set; }

    private bool IsSendDisabled => _isBusy || string.IsNullOrWhiteSpace(BuildCommandText());

    private string ShellClass => "h-screen min-w-0 bg-transparent text-[#d9e2f1]";

    private string SidebarClass => "hidden";

    private string SidebarBrandClass => _isSidebarCollapsed
        ? "pointer-events-none w-0 overflow-hidden whitespace-nowrap text-lg font-semibold tracking-normal text-white opacity-0"
        : "text-lg font-semibold tracking-normal text-white";

    private string SidebarTextClass => _isSidebarCollapsed
        ? "w-0 overflow-hidden whitespace-nowrap opacity-0"
        : "min-w-0 truncate opacity-100";

    private string SidebarFullOnlyClass => _isSidebarCollapsed
        ? "hidden"
        : "flex min-h-0 flex-1 flex-col";

    private string SidebarProfileClass => _isSidebarCollapsed
        ? "mt-auto flex items-center justify-center rounded-2xl px-2 py-2"
        : "mt-4 flex items-center gap-3 rounded-2xl px-2 py-2";

    private string SidebarProfileTextClass => _isSidebarCollapsed
        ? "hidden"
        : "min-w-0 flex-1";

    private string SidebarToggleTitle => _isSidebarCollapsed ? "Expand sidebar" : "Collapse sidebar";

    private string SidebarToggleIconClass => _isSidebarCollapsed
        ? "size-5 rotate-180 transition-transform duration-300"
        : "size-5 transition-transform duration-300";

    private string ActiveChatTitle =>
        _activeChatId is Guid activeChatId
            ? _chats.FirstOrDefault(chat => chat.Id == activeChatId)?.Title ?? "PcAssistant"
            : "PcAssistant";

    private string CommandInputPlaceholder => _selectedDirectories.Count == 0
        ? "Type a PC command... use @dir:"
        : "Continue command... use @folder:";

    private RenderFragment ComposerInput(string textSize, string placeholder) => @<div class="flex min-h-12 w-full flex-wrap items-center gap-1.5 rounded-2xl bg-transparent @textSize text-white">
        @if (_selectedDirectories.Count == 0)
        {
            <input id="@CommandInputId"
                   class="@CommandInputClass(textSize)"
                   placeholder="@placeholder"
                   value="@_input"
                   @oninput="OnCommandInputAsync"
                   disabled="@_isBusy" />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_input))
            {
                <span class="shrink-0 font-semibold text-white">@_input</span>
            }

            @for (var chipIndex = 0; chipIndex < _selectedDirectories.Count; chipIndex++)
            {
                var currentChipIndex = chipIndex;
                var selectedDirectory = _selectedDirectories[chipIndex];
                if (chipIndex > 0)
                {
                    <span class="flex size-5 shrink-0 items-center justify-center text-[#8fa1bc]" aria-hidden="true">
                        @ChevronRightIcon()
                    </span>
                }

                <span class="inline-flex max-w-[14rem] shrink-0 items-center gap-1.5 rounded-lg border border-[#476487] bg-[#26364f] px-2 py-1 text-[#d7e7ff]">
                    <span class="@DirectoryChipIconClass(selectedDirectory.Kind)" aria-hidden="true">@DirectoryIcon(selectedDirectory.Kind)</span>
                    <span class="truncate text-xs font-semibold">@selectedDirectory.DisplayName</span>
                    <button class="flex size-5 shrink-0 items-center justify-center rounded-full text-[#d7e7ff] transition hover:bg-white/12 hover:text-white"
                            type="button"
                            title="Remove this directory"
                            @onclick="() => RemoveSelectedDirectory(currentChipIndex)">
                        @CloseIcon()
                    </button>
                </span>
            }

            <input id="@CommandInputId"
