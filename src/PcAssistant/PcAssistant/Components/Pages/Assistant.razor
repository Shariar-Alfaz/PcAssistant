            "drive" => "bg-indigo-100 text-indigo-700 dark:bg-indigo-300/[0.2] dark:text-indigo-100",
            "known-folder" => "bg-amber-100 text-amber-700 dark:bg-amber-300/[0.2] dark:text-amber-100",
            _ => "bg-cyan-100 text-cyan-700 dark:bg-cyan-300/[0.2] dark:text-cyan-100",
        };

        return $"flex size-5 shrink-0 items-center justify-center rounded-md [&_svg]:size-3.5 {colorClass}";
    }

    private AssistantDirectoryTrigger? FindDirectoryTrigger()
    {
        var directoryIndex = _input.LastIndexOf("@dir:", StringComparison.OrdinalIgnoreCase);
        var folderIndex = _input.LastIndexOf("@folder:", StringComparison.OrdinalIgnoreCase);

        if (directoryIndex < 0 && folderIndex < 0)
        {
            return null;
        }

        var token = folderIndex > directoryIndex ? "@folder:" : "@dir:";
        var index = folderIndex > directoryIndex ? folderIndex : directoryIndex;
        var query = _input[(index + token.Length)..].Trim();
        return new AssistantDirectoryTrigger(index, token, query);
    }

    private static bool PathsEqual(string first, string second)
    {
        return first.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            .Equals(
                second.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                StringComparison.OrdinalIgnoreCase);
    }

