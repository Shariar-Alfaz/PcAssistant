        return $"min-h-8 min-w-[12rem] flex-1 bg-transparent {textSize} text-white outline-none placeholder:text-[#8995ad] disabled:text-[#8995ad]";
    }

    private bool CanExecutePendingCommand =>
        _pendingCommand is not null
        && !_pendingCommand.IsDangerous
        && _pendingCommand.CommandLabel != "unknown";

    private bool CanEditPendingPath =>
        _pendingCommand?.CommandLabel is "filesystem.create_folder"
            or "filesystem.delete_folder"
            or "filesystem.open_folder"
            or "filesystem.get_file_details";

    private bool ShowDirectorySuggestions => _showDirectorySuggestions && _directorySuggestions.Count > 0;

    private string PanelClass => _pendingCommand?.IsDangerous == true
        ? "mt-5 rounded-[1.25rem] border border-rose-300/25 bg-rose-950/60 p-4 text-rose-100 shadow-sm"
        : _pendingCommand?.RequiresConfirmation == true || _lowConfidenceRequiresConfirmation
            ? "mt-5 rounded-[1.25rem] border border-amber-300/25 bg-amber-950/50 p-4 text-amber-100 shadow-sm"
            : "mt-5 rounded-[1.25rem] border border-[#8ec5ff]/20 bg-[#0f6cbd]/20 p-4 text-[#d8ecff] shadow-sm";

    private string PanelTitle => _pendingCommand?.IsDangerous == true
        ? "Blocked command"
        : _pendingCommand?.RequiresConfirmation == true || _lowConfidenceRequiresConfirmation
            ? "Confirmation required"
            : "Ready to execute";

    private string PanelMessage => _pendingCommand?.Preview ?? "No command preview is available.";

    private bool IsPendingFolderCommand =>
        _pendingCommand?.CommandLabel is "filesystem.create_folder" or "filesystem.delete_folder";

    private bool IsPendingDeleteFolderCommand => _pendingCommand?.CommandLabel == "filesystem.delete_folder";

    private string CommandConfirmationTitle => IsPendingDeleteFolderCommand
        ? "Delete folder?"
        : "Run folder command?";

    private string CommandConfirmationMessage => IsPendingDeleteFolderCommand
        ? "This action can remove files from your PC. Review the target folder before continuing."
        : "Review the target folder before running this command.";

    private string CommandConfirmationButtonText => IsPendingDeleteFolderCommand ? "Delete folder" : "Run command";

    private string CommandConfirmationIconClass => IsPendingDeleteFolderCommand
        ? "flex size-10 shrink-0 items-center justify-center rounded-xl bg-rose-400/15 text-rose-200"
        : "flex size-10 shrink-0 items-center justify-center rounded-xl bg-amber-300/15 text-amber-100";

    private string CommandConfirmationButtonClass => IsPendingDeleteFolderCommand
        ? "rounded-xl bg-rose-400 px-4 py-2 text-sm font-semibold text-[#21080d] transition hover:bg-rose-300 disabled:bg-rose-400/40"
        : "rounded-xl bg-[#dce9ff] px-4 py-2 text-sm font-semibold text-[#0b1427] transition hover:bg-white disabled:bg-white/20 disabled:text-[#aab6c9]";

    private void ToggleSidebar()
