    private async Task RefreshScheduledTasksAsync()
    {
        if (_isRefreshingScheduledTasks)
        {
            return;
        }

        _isRefreshingScheduledTasks = true;
        try
        {
            await ScheduledTasks.CompleteDueTasksAsync();
            var tasks = await ScheduledTasks.ListQueuedAsync();
            _scheduledTasks.Clear();
            _scheduledTasks.AddRange(tasks);
        }
        finally
