    private async Task SelectChatAsync(Guid chatSessionId)
    {
        _errorMessage = null;
        _pendingCommand = null;
        _pendingCommandLogId = null;
        _pendingPathText = string.Empty;
        _pendingPathError = null;
        _lastResponse = null;
        _lowConfidenceRequiresConfirmation = false;
        _pathTailInput = string.Empty;
        ClearDirectorySuggestions();
        _activeChatId = chatSessionId;
        _loadingChatId = chatSessionId;
        _isLoadingSelectedChat = true;
        _isLoadingOlderMessages = false;
        _hasOlderMessages = false;
        _oldestLoadedMessageCreatedAtUtc = null;
        _history.Clear();
        StateHasChanged();

        try
        {
            var chat = await CommandHistory.GetChatAsync(chatSessionId, ChatMessagePageSize);
            if (_loadingChatId != chatSessionId)
            {
                return;
            }

            _history.Clear();
            _history.AddRange(chat.Messages.Select(AssistantHistoryItem.FromCommandHistory));
            ApplyChatPageState(chat);
            _scrollMessagesToBottomAfterRender = true;

            var existingIndex = _chats.FindIndex(existingChat => existingChat.Id == chatSessionId);
            if (existingIndex >= 0)
            {
                _chats[existingIndex] = chat.Summary;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load chat messages: {ex.Message}";
        }
        finally
        {
            if (_loadingChatId == chatSessionId)
            {
                _isLoadingSelectedChat = false;
                _loadingChatId = null;
            }
        }
    }

    private async Task LoadOlderMessagesAsync()
    {
        if (_activeChatId is not Guid activeChatId
            || _isLoadingSelectedChat
            || _isLoadingOlderMessages
            || !_hasOlderMessages)
        {
            return;
        }

        _isLoadingOlderMessages = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            if (_olderMessageScrollHeightBeforeLoad <= 0)
            {
                var metrics = await JsRuntime.InvokeAsync<MessageListMetrics>(
                    "pcAssistantMessageList.getMetrics",
                    _messageListElement);
                _olderMessageScrollHeightBeforeLoad = metrics.ScrollHeight;
            }

            var chat = await CommandHistory.GetChatAsync(
                activeChatId,
                ChatMessagePageSize,
                _oldestLoadedMessageCreatedAtUtc);
            if (_activeChatId != activeChatId)
            {
                return;
            }

            var existingIds = _history.Select(item => item.Id).ToHashSet();
            var olderMessages = chat.Messages
                .Where(message => !existingIds.Contains(message.Id))
                .Select(AssistantHistoryItem.FromCommandHistory)
                .ToArray();
            _history.InsertRange(0, olderMessages);
            ApplyChatPageState(chat);
            if (olderMessages.Length > 0)
            {
                _restoreOlderMessageScrollAfterRender = true;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load older messages: {ex.Message}";
        }
        finally
        {
            _isLoadingOlderMessages = false;
        }
    }

    private async Task OnMessageListScrollAsync()
    {
        if (!_hasOlderMessages || _isLoadingOlderMessages || _isLoadingSelectedChat)
        {
            return;
        }

        var metrics = await JsRuntime.InvokeAsync<MessageListMetrics>(
            "pcAssistantMessageList.getMetrics",
            _messageListElement);
        if (metrics.ScrollTop > 96)
        {
            return;
        }

        _olderMessageScrollHeightBeforeLoad = metrics.ScrollHeight;
        await LoadOlderMessagesAsync();
    }

    private void ApplyChatPageState(ChatSessionDetails chat)
    {
        _hasOlderMessages = chat.HasOlderMessages;
        _oldestLoadedMessageCreatedAtUtc = _history.Count == 0
            ? null
            : _history.Min(item => item.CreatedAtUtc);
    }

    private void RequestDeleteChat(Guid chatSessionId)
    {
        _chatPendingDeletion = _chats.FirstOrDefault(chat => chat.Id == chatSessionId);
    }

    private void CancelDeleteChat()
    {
        if (_isDeletingChat)
        {
            return;
        }

        _chatPendingDeletion = null;
    }

    private async Task ConfirmDeleteChatAsync()
    {
        if (_chatPendingDeletion is null)
        {
            return;
        }

        _isDeletingChat = true;
        try
        {
            await DeleteChatAsync(_chatPendingDeletion.Id);
            _chatPendingDeletion = null;
        }
        finally
        {
            _isDeletingChat = false;
        }
    }

    private async Task DeleteChatAsync(Guid chatSessionId)
    {
        _errorMessage = null;
        await CommandHistory.DeleteChatAsync(chatSessionId);
        _chats.RemoveAll(chat => chat.Id == chatSessionId);

        if (_chats.Count == 0)
        {
            var newChat = await CommandHistory.CreateChatAsync();
            _chats.Add(newChat);
        }

        var nextChatId = _activeChatId == chatSessionId
            ? _chats[0].Id
            : _activeChatId ?? _chats[0].Id;
        await SelectChatAsync(nextChatId);
    }

    private static bool HasInlinePath(string text)
    {
        return !string.IsNullOrWhiteSpace(text) && InlinePathRegex.IsMatch(text);
    }

    private static MarkupString HighlightCommandPaths(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return new MarkupString(string.Empty);
        }

        var cursor = 0;
        var builder = new System.Text.StringBuilder();
        foreach (System.Text.RegularExpressions.Match match in InlinePathRegex.Matches(text))
        {
            if (match.Index > cursor)
            {
                builder.Append(System.Net.WebUtility.HtmlEncode(text[cursor..match.Index]));
            }

            var path = match.Groups["path"].Value;
            builder
                .Append("<span class=\"inline-path-highlight\">")
                .Append(System.Net.WebUtility.HtmlEncode(path))
                .Append("</span>");
            cursor = match.Index + match.Length;
        }

        if (cursor < text.Length)
        {
            builder.Append(System.Net.WebUtility.HtmlEncode(text[cursor..]));
        }

        return new MarkupString(builder.ToString());
    }

    private string BuildCommandText()
    {
        var commandText = _input.Trim();
        var tailText = _pathTailInput.Trim();
        var selectedPath = CurrentSelectedDirectoryPath;
        if (string.IsNullOrWhiteSpace(selectedPath))
        {
            return string.IsNullOrWhiteSpace(tailText)
                ? commandText
                : $"{commandText} {tailText}".Trim();
        }

        var commandWithPath = string.IsNullOrWhiteSpace(commandText)
            ? selectedPath
            : $"{commandText} {selectedPath}".Trim();

        return string.IsNullOrWhiteSpace(tailText)
            ? commandWithPath
            : $"{commandWithPath} {tailText}".Trim();
    }

