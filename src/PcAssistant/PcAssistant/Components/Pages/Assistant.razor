    private void OnPendingRestartDelayInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        _pendingRestartDelaySeconds = int.TryParse(value, out var seconds)
            ? Math.Clamp(seconds, 1, (int)MaximumRestartScheduleDelay.TotalSeconds)
            : (int)RestartScheduleDelay.TotalSeconds;
        RefreshPendingRestartDelay();
    }

    private void RefreshPendingPath()
    {
        if (_pendingCommand is null || !CanEditPendingPath)
        {
            return;
        }

        var validation = SafetyValidator.ValidateFileSystemTarget(_pendingPathText);
        var targetPath = validation.ResolvedPath ?? _pendingPathText.Trim();
        var isBlocked = !validation.IsAllowed || string.IsNullOrWhiteSpace(validation.ResolvedPath);
        _pendingPathError = isBlocked ? validation.Message ?? "The folder path is blocked." : null;
        _pendingCommand = CreateEditedPathCommand(_pendingCommand, targetPath, isBlocked, _pendingPathError);
    }

    private static ParsedCommand CreateEditedPathCommand(
        ParsedCommand command,
        string targetPath,
        bool isBlocked,
        string? errorMessage)
    {
        return new ParsedCommand
        {
            CommandLabel = command.CommandLabel,
            OriginalText = command.OriginalText,
            FolderName = string.IsNullOrWhiteSpace(targetPath) ? command.FolderName : Path.GetFileName(targetPath.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)),
            LocationAlias = command.LocationAlias,
            LocationType = command.LocationType,
            PathText = targetPath,
            ResolvedPath = string.IsNullOrWhiteSpace(targetPath) ? null : targetPath,
            RestartDelay = command.RestartDelay,
            RequiresConfirmation = command.RequiresConfirmation,
            IsDangerous = isBlocked,
            Preview = isBlocked
                ? errorMessage ?? "The folder path is blocked."
                : BuildPathPreview(command.CommandLabel, targetPath),
            ErrorMessage = isBlocked ? errorMessage : null,
        };
    }

    private void RefreshPendingRestartDelay()
    {
        if (_pendingCommand is null || !CanEditPendingRestart)
        {
            return;
        }

        var delay = TimeSpan.FromSeconds(Math.Clamp(
            _pendingRestartDelaySeconds,
            1,
            (int)MaximumRestartScheduleDelay.TotalSeconds));
        _pendingRestartDelaySeconds = (int)delay.TotalSeconds;
        _pendingCommand = CreateEditedRestartCommand(_pendingCommand, delay);
    }

    private static ParsedCommand CreateEditedRestartCommand(ParsedCommand command, TimeSpan delay)
    {
        return new ParsedCommand
        {
            CommandLabel = command.CommandLabel,
            OriginalText = command.OriginalText,
            FolderName = command.FolderName,
            LocationAlias = command.LocationAlias,
            LocationType = command.LocationType,
            PathText = command.PathText,
            ResolvedPath = command.ResolvedPath,
            RestartDelay = delay,
            RequiresConfirmation = command.RequiresConfirmation,
            IsDangerous = command.IsDangerous,
            Preview = $"Restart this PC {FormatDelayPreview(delay)}.",
            ErrorMessage = command.ErrorMessage,
        };
    }

    private static int RestartDelaySeconds(TimeSpan? delay)
    {
        var normalized = delay is null || delay.Value < TimeSpan.FromSeconds(1)
            ? RestartScheduleDelay
            : delay.Value > MaximumRestartScheduleDelay
                ? MaximumRestartScheduleDelay
                : delay.Value;
        return Math.Max(1, (int)Math.Round(normalized.TotalSeconds));
    }

    private static string FormatDelayPreview(TimeSpan delay)
    {
        if (delay.TotalHours >= 1 && delay.TotalHours % 1 == 0)
        {
            var hours = (int)delay.TotalHours;
            return $"after {hours} {(hours == 1 ? "hour" : "hours")}";
        }

        if (delay.TotalMinutes >= 1 && delay.TotalMinutes % 1 == 0)
        {
            var minutes = (int)delay.TotalMinutes;
            return $"after {minutes} {(minutes == 1 ? "minute" : "minutes")}";
        }

        var seconds = Math.Max(1, (int)Math.Round(delay.TotalSeconds));
        return $"after {seconds} {(seconds == 1 ? "second" : "seconds")}";
    }

