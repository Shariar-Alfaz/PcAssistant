    private static string FormalAssistantMessage(AssistantHistoryItem item)
    {
        if (item.CommandLabel == "unknown")
        {
            return item.AssistantMessage;
        }

        if (item.ExecutionStatus.Equals("succeeded", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action completed successfully.";
        }

        if (item.ExecutionStatus.Equals("failed", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action could not be completed.";
        }

        if (item.ExecutionStatus.Equals("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action was cancelled.";
        }

        if (item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase))
        {
            return "Review the action details and confirm when you are ready.";
        }

        return "Review the action details before continuing.";
    }

    private static string ActionStatusText(AssistantHistoryItem item)
    {
        return item.ExecutionStatus.ToLowerInvariant() switch
        {
            "succeeded" => "Completed",
            "failed" => "Failed",
            "cancelled" => "Cancelled",
            _ when item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase) => "Needs confirmation",
            _ => "Ready",
        };
    }

    private static string ActionStatusClass(AssistantHistoryItem item)
    {
        var baseClass = "rounded-full px-3 py-1 text-xs font-semibold";
        return item.ExecutionStatus.ToLowerInvariant() switch
        {
            "succeeded" => $"{baseClass} bg-emerald-300/15 text-emerald-100 ring-1 ring-emerald-300/25",
            "failed" => $"{baseClass} bg-rose-300/15 text-rose-100 ring-1 ring-rose-300/25",
            "cancelled" => $"{baseClass} bg-slate-300/15 text-slate-100 ring-1 ring-slate-300/25",
            _ when item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase) => $"{baseClass} bg-amber-300/15 text-amber-100 ring-1 ring-amber-300/25",
            _ => $"{baseClass} bg-sky-300/15 text-sky-100 ring-1 ring-sky-300/25",
        };
    }

    private static string FormatConfidence(double confidence)
    {
        return $"{confidence:P0}";
    }

    private static string ConfidenceClass(double confidence)
    {
        if (confidence < 0.60)
        {
            return "rounded-full bg-rose-100 px-2 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-400/[0.12] dark:text-rose-200";
        }

        if (confidence < 0.80)
        {
            return "rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-400/[0.12] dark:text-amber-200";
        }

        return "rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-400/[0.12] dark:text-emerald-200";
    }

    public void Dispose()
    {
        _directoryPickerReference?.Dispose();
    }

    private void ReplaceHistoryItem(AssistantHistoryItem item)
    {
        var index = _history.FindIndex(existingItem => existingItem.Id == item.Id);
        if (index >= 0)
        {
            _history[index] = item;
            return;
        }

        _history.Add(item);
    }

