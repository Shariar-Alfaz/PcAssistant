    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _directoryPickerReference = DotNetObjectReference.Create(this);
        }

        if (_directoryPickerReference is not null)
        {
            await JsRuntime.InvokeVoidAsync(
                "pcAssistantDirectoryPicker.bind",
                CommandInputId,
                _directoryPickerReference);
        }

        if (_focusCommandInputAfterRender)
        {
            _focusCommandInputAfterRender = false;
            await JsRuntime.InvokeVoidAsync("pcAssistantDirectoryPicker.focus", CommandInputId);
        }

        if (_restoreOlderMessageScrollAfterRender)
        {
            _restoreOlderMessageScrollAfterRender = false;
            await JsRuntime.InvokeVoidAsync(
                "pcAssistantMessageList.restoreAfterPrepend",
                _messageListElement,
                _olderMessageScrollHeightBeforeLoad);
            _olderMessageScrollHeightBeforeLoad = 0;
        }

        if (_scrollMessagesToBottomAfterRender)
        {
            _scrollMessagesToBottomAfterRender = false;
            await JsRuntime.InvokeVoidAsync("pcAssistantMessageList.scrollToBottom", _messageListElement);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshScheduledTasksAsync();
            await LoadChatsAsync();
            if (RequestedChatId is Guid chatId)
            {
                await SelectChatAsync(chatId);
            }

            StartScheduledTaskTimer();
        }
        catch (Exception ex)
        {
            _isLoadingChats = false;
            _errorMessage = $"Could not load command history: {ex.Message}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isLoadingChats || RequestedChatId is not Guid chatId || _activeChatId == chatId)
        {
            return;
        }

        await SelectChatAsync(chatId);
    }

    private async Task SendAsync()
    {
        var text = BuildCommandText();
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        _pendingCommand = null;
        _pendingPathText = string.Empty;
        _pendingPathError = null;
        _pendingRestartDelaySeconds = (int)RestartScheduleDelay.TotalSeconds;
        _lastResponse = null;
        _lowConfidenceRequiresConfirmation = false;
        _pendingCommandLogId = null;
        ClearDirectorySuggestions();
        var selectedDirectories = _selectedDirectories.ToArray();

        try
        {
            var activeChatId = _activeChatId ?? await CreateChatForFirstCommandAsync();
            var response = await AiClient.PredictAsync(text);
            _lastResponse = response;

            _effectiveLabel = response.Confidence < 0.60 ? "unknown" : response.CommandLabel;
            _lowConfidenceRequiresConfirmation = response.Confidence >= 0.60 && response.Confidence < 0.80;
            var requiresConfirmation = response.RequiresConfirmation || _lowConfidenceRequiresConfirmation;
            var parsed = Parser.Parse(_effectiveLabel, text, requiresConfirmation);
            _pendingCommand = parsed;
            _pendingPathText = parsed.ResolvedPath ?? parsed.PathText ?? string.Empty;
            _pendingRestartDelaySeconds = RestartDelaySeconds(parsed.RestartDelay);

            var message = BuildPredictionMessage(response, parsed);
            var historyItem = await CommandHistory.RecordPredictionAsync(
                activeChatId,
                text,
                response,
                parsed,
                _effectiveLabel,
                message,
                _lowConfidenceRequiresConfirmation);

            _history.Add(AssistantHistoryItem.FromCommandHistory(historyItem));
            _oldestLoadedMessageCreatedAtUtc = _history.Min(item => item.CreatedAtUtc);
            _scrollMessagesToBottomAfterRender = true;
            _pendingCommandLogId = historyItem.Id;
            await RefreshChatsAsync(activeChatId);

            _input = string.Empty;
            _pathTailInput = string.Empty;
            if (selectedDirectories.Length > 0)
            {
                _selectedDirectories.Clear();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_pendingCommand is null || !CanExecutePendingCommand)
        {
            return;
        }

        if (CanEditPendingPath)
        {
            RefreshPendingPath();
            if (_pendingCommand is null || !CanExecutePendingCommand)
            {
                return;
            }

            if (_pendingCommandLogId is Guid pathUpdateLogId)
            {
                var updatedHistory = await CommandHistory.UpdatePlannedTargetAsync(
                    pathUpdateLogId,
                    _pendingCommand,
                    BuildPendingAssistantMessage(_pendingCommand));
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(updatedHistory));
            }
        }
        else if (CanEditPendingRestart)
        {
            RefreshPendingRestartDelay();
            if (_pendingCommandLogId is Guid restartUpdateLogId && _pendingCommand is not null)
            {
                var updatedHistory = await CommandHistory.UpdatePlannedTargetAsync(
                    restartUpdateLogId,
                    _pendingCommand,
                    BuildPendingAssistantMessage(_pendingCommand));
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(updatedHistory));
            }
        }

        var commandToExecute = _pendingCommand;
        if (commandToExecute is null)
        {
            return;
        }

        _isExecuting = true;
        _errorMessage = null;

        try
        {
            var result = await Executor.ExecuteAsync(commandToExecute, confirmed: true);
            if (_pendingCommandLogId is Guid commandLogId)
            {
                var historyItem = await CommandHistory.RecordExecutionAsync(commandLogId, result);
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(historyItem));

                if (result.Succeeded && commandToExecute.CommandLabel == "system.restart")
                {
                    await ScheduledTasks.QueueRestartAsync(
                        _activeChatId,
                        commandLogId,
                        commandToExecute.RestartDelay ?? RestartScheduleDelay,
                        result.Message);
                    await RefreshScheduledTasksAsync();
                }
                else if (result.Succeeded && commandToExecute.CommandLabel == "system.cancel_restart")
                {
                    await ScheduledTasks.CancelQueuedRestartTasksAsync(result.Message);
                    await RefreshScheduledTasksAsync();
                }
            }

            _pendingCommand = null;
            _pendingCommandLogId = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task RequestCommandConfirmation()
    {
        if (_pendingCommand is null || !CanExecutePendingCommand)
        {
            return;
        }

        if (IsPendingFolderCommand)
        {
            _showCommandConfirmationModal = true;
            return;
        }

        await ConfirmAsync();
    }

    private void CancelCommandConfirmation()
    {
        _showCommandConfirmationModal = false;
    }

    private async Task ConfirmCommandFromModalAsync()
    {
        _showCommandConfirmationModal = false;
        await ConfirmAsync();
    }

    private async Task CancelPending()
    {
        if (_pendingCommand is not null && _pendingCommandLogId is Guid commandLogId)
        {
            var historyItem = await CommandHistory.RecordCancellationAsync(commandLogId, "Command cancelled.");
            ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(historyItem));
        }

        _pendingCommand = null;
        _pendingCommandLogId = null;
        _pendingPathText = string.Empty;
        _pendingPathError = null;
        _pendingRestartDelaySeconds = (int)RestartScheduleDelay.TotalSeconds;
    }

    private async Task CancelScheduledTaskAsync(ScheduledTaskItem task)
    {
        if (_cancellingScheduledTaskId is not null)
        {
            return;
        }

        _cancellingScheduledTaskId = task.Id;
        _errorMessage = null;

        try
        {
            if (IsMessageAutomationTask(task))
            {
                var removed = await ScheduledTasks.CancelQueuedTaskAsync(task.Id, "Message automation removed.");
                if (removed is null)
                {
                    _errorMessage = "The scheduled automation was no longer queued.";
                }

                await RefreshScheduledTasksAsync();
                return;
            }

            if (IsWebAutomationTask(task))
            {
                var removed = await ScheduledTasks.CancelQueuedTaskAsync(task.Id, "Web automation cancelled.");
                if (removed is null)
                {
                    _errorMessage = "The scheduled web automation was no longer queued.";
                }

                await RefreshScheduledTasksAsync();
                return;
            }

            var result = await Executor.ExecuteAsync(
                new ParsedCommand
                {
                    CommandLabel = "system.cancel_restart",
                    OriginalText = "cancel restart",
                    Preview = "Cancel a pending Windows restart or shutdown.",
                },
                confirmed: true);

            if (!result.Succeeded)
            {
                _errorMessage = result.Message;
                return;
            }

            var cancelled = await ScheduledTasks.CancelQueuedTaskAsync(task.Id, result.Message);
            if (cancelled is null)
            {
                _errorMessage = "The scheduled task was no longer queued.";
            }

            if (task.CommandLogId is Guid commandLogId)
            {
                var historyItem = await CommandHistory.RecordCancellationAsync(commandLogId, result.Message);
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(historyItem));
            }

            await RefreshScheduledTasksAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _cancellingScheduledTaskId = null;
        }
    }

    private async Task OnCommandInputAsync(ChangeEventArgs args)
    {
        _input = args.Value?.ToString() ?? string.Empty;
        await RefreshDirectorySuggestionsAsync();
    }

    private async Task OnPathTailInputAsync(ChangeEventArgs args)
    {
        _pathTailInput = args.Value?.ToString() ?? string.Empty;
        await RefreshDirectorySuggestionsAsync();
    }

    private async Task RefreshDirectorySuggestionsAsync()
    {
        var trigger = FindDirectoryTrigger();
        if (trigger is null)
        {
            ClearDirectorySuggestions();
            return;
        }

        IReadOnlyList<DirectorySuggestion> suggestions;
        var currentPath = CurrentSelectedDirectoryPath;
        if (!string.IsNullOrWhiteSpace(currentPath)
            && trigger.Value.Token.Equals("@folder:", StringComparison.OrdinalIgnoreCase))
        {
            var queryPath = string.IsNullOrWhiteSpace(trigger.Value.Query)
                ? currentPath
                : Path.Combine(currentPath, trigger.Value.Query);
            suggestions = (await DirectorySuggestions.SuggestAsync(queryPath, 32))
                .Where(suggestion => !PathsEqual(suggestion.Path, currentPath))
                .Select(suggestion => suggestion with { Kind = "folder" })
                .ToArray();
            _directorySuggestionTitle = "Folders";
        }
        else if (!string.IsNullOrWhiteSpace(currentPath)
            && !trigger.Value.Token.Equals("@dir:", StringComparison.OrdinalIgnoreCase))
        {
            suggestions = await DirectorySuggestions.SuggestChildrenAsync(currentPath, trigger.Value.Query, 32);
            _directorySuggestionTitle = $"Inside {FormatLocationName(currentPath)}";
        }
        else
        {
            suggestions = await DirectorySuggestions.SuggestAsync(trigger.Value.Query, 32);
            _directorySuggestionTitle = "Locations";
        }

        _directorySuggestions.Clear();
        _directorySuggestions.Add(PickLocationSuggestion);
        _directorySuggestions.AddRange(suggestions);
        _selectedDirectoryIndex = _directorySuggestions.Count > 0 ? 0 : -1;
        _showDirectorySuggestions = _directorySuggestions.Count > 0;
    }

    [JSInvokable]
    public async Task<bool> HandleDirectoryPickerKeyAsync(string key)
    {
        if (!ShowDirectorySuggestions)
        {
            return false;
        }

        switch (key)
        {
            case "ArrowDown":
                _selectedDirectoryIndex = Math.Min(_selectedDirectoryIndex + 1, _directorySuggestions.Count - 1);
                StateHasChanged();
                return true;
            case "ArrowUp":
                _selectedDirectoryIndex = Math.Max(_selectedDirectoryIndex - 1, 0);
                StateHasChanged();
                return true;
            case "Tab":
            case "Enter":
                await SelectDirectorySuggestionAsync(_selectedDirectoryIndex < 0 ? 0 : _selectedDirectoryIndex);
                return true;
            case "Escape":
                ClearDirectorySuggestions();
                StateHasChanged();
                return true;
            default:
                return false;
        }
    }

    private async Task SelectDirectorySuggestionAsync(int index)
    {
        if (index < 0 || index >= _directorySuggestions.Count)
        {
            return;
        }

        var trigger = FindDirectoryTrigger();
        var hadSelectedDirectories = _selectedDirectories.Count > 0;
        var selectedDirectory = _directorySuggestions[index];
        if (selectedDirectory.Kind == PickLocationKind)
        {
            var pickedLocation = await LocationPicker.PickDirectoryAsync();
            if (pickedLocation is null)
            {
                ClearDirectorySuggestions();
                StateHasChanged();
                return;
            }

            _selectedDirectories.Clear();
            _selectedDirectories.Add(pickedLocation);
        }
        else if (!string.IsNullOrWhiteSpace(CurrentSelectedDirectoryPath)
            && trigger?.Token.Equals("@dir:", StringComparison.OrdinalIgnoreCase) != true)
        {
            _selectedDirectories.Add(selectedDirectory);
        }
        else
        {
            _selectedDirectories.Clear();
            _selectedDirectories.Add(selectedDirectory);
        }

        ClearTriggerInput(trigger, hadSelectedDirectories);
        _focusCommandInputAfterRender = true;

        ClearDirectorySuggestions();
        StateHasChanged();
    }

