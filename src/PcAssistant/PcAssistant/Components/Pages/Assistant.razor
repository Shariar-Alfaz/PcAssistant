@page "/assistant"
@inject ICommandAiClient AiClient
@inject ICommandParserService Parser
@inject IWindowsCommandExecutor Executor
@inject ICommandHistoryService CommandHistory
@inject IDirectorySuggestionService DirectorySuggestions
@inject ILocationPickerService LocationPicker
@inject ICommandSafetyValidator SafetyValidator
@inject IJSRuntime JsRuntime
@implements IDisposable

<PageTitle>Assistant</PageTitle>

<section class="@ShellClass">
    <aside class="@SidebarClass">
        <div class="flex items-center justify-between px-2">
            <a class="@SidebarBrandClass" href="">Copilot</a>
            <button class="flex size-8 items-center justify-center rounded-lg text-[#c9d2e3] transition hover:bg-white/10"
                    type="button"
                    title="@SidebarToggleTitle"
                    @onclick="ToggleSidebar">
                <svg class="@SidebarToggleIconClass" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 5h14v14H5V5Zm5 0v14" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
            </button>
        </div>

        <nav class="mt-7 space-y-2">
            <button class="copilot-nav-item"
                    type="button"
                    @onclick="NewChatAsync">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 19h11.5A2.5 2.5 0 0 0 19 16.5V12m-7-7H7.5A2.5 2.5 0 0 0 5 7.5V12m7-7v6m-3-3h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">New chat</span>
            </button>
            <a class="copilot-nav-item" href="assistant">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 7.5A2.5 2.5 0 0 1 9.5 5H18a2 2 0 0 1 2 2v9.5A2.5 2.5 0 0 1 17.5 19H8a2 2 0 0 1-2-2V8.5A3.5 3.5 0 0 0 2.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M3 5h6.5A2.5 2.5 0 0 1 12 7.5V17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">Library</span>
            </a>
            <span class="copilot-nav-item">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7.5 12.5 10 15l6-6M6.5 4.5h11A2.5 2.5 0 0 1 20 7v10a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17V7a2.5 2.5 0 0 1 2.5-2.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">Tasks</span>
                <span class="@SidebarBadgeClass">Preview</span>
            </span>
            <span class="copilot-nav-item">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3.5 8.5A2.5 2.5 0 0 1 6 6h4l2 2.5h6A2.5 2.5 0 0 1 20.5 11v5.5A2.5 2.5 0 0 1 18 19H6a2.5 2.5 0 0 1-2.5-2.5v-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">Projects</span>
                <span class="@SidebarProjectAddClass">+</span>
            </span>
        </nav>

        <div class="my-5 h-px bg-white/18"></div>

        <nav class="space-y-2">
            <span class="copilot-nav-item">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-3.5-5.5 7-7m-5.5-.5 5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <span class="@SidebarTextClass">Discover</span>
            </span>
            <span class="copilot-nav-item">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 5h8v8H5V5Zm6 6 8 8m-5-8h5v5M4.5 18.5l3-4 3 4h-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="@SidebarTextClass">Imagine</span>
            </span>
            <span class="copilot-nav-item">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 7h4v4H5V7Zm10 0h4v4h-4V7ZM5 15h4v4H5v-4Zm10 0h4v4h-4v-4Z" stroke="currentColor" stroke-width="1.7" />
                </svg>
                <span class="@SidebarTextClass">Experiments</span>
            </span>
        </nav>

        <div class="@SidebarFullOnlyClass">
            <div class="mt-5 h-px bg-white/18"></div>

            <div class="mt-4 min-h-0 flex-1 overflow-y-auto pr-1">
                @if (_isLoadingChats)
                {
                    <p class="px-2 py-2 text-sm text-[#9da8ba]">Loading chats...</p>
                }
                else if (_chats.Count == 0)
                {
                    <p class="px-2 py-2 text-sm text-[#9da8ba]">No chats yet.</p>
                }
                else
                {
                    @foreach (var chat in _chats)
                    {
                        <div class="@ChatRowClass(chat.Id)">
                            <button class="min-w-0 flex-1 truncate text-left"
                                    type="button"
                                    title="@chat.Title"
                                    @onclick="() => SelectChatAsync(chat.Id)">
                                @chat.Title
                            </button>
                            <button class="flex size-7 shrink-0 items-center justify-center rounded-md text-[#9da8ba] opacity-0 transition group-hover:opacity-100 hover:bg-white/10 hover:text-rose-200"
                                    type="button"
                                    title="Delete chat"
                                    @onclick="() => RequestDeleteChat(chat.Id)">
                                <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                    <path d="M6 7h12m-9 0V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m-7 0 .7 12h6.6L16 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </button>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="@SidebarProfileClass">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-[#33415f] text-sm font-semibold text-white">S</span>
            <span class="@SidebarProfileTextClass">
                <span class="block truncate text-sm font-semibold text-white">Shariar</span>
                <span class="block truncate text-xs text-[#a8b2c4]">Free Plan</span>
            </span>
            <button class="@SidebarUpgradeClass"
                    type="button">
                Upgrade
            </button>
        </div>
    </aside>

    <main class="relative h-screen min-h-0 min-w-0 overflow-hidden bg-[radial-gradient(circle_at_44%_68%,rgba(210,213,207,0.75),transparent_0.15rem),radial-gradient(circle_at_39%_72%,rgba(249,250,244,0.85),transparent_0.18rem),radial-gradient(circle_at_48%_78%,rgba(236,238,232,0.75),transparent_0.12rem),linear-gradient(180deg,#00466c_0%,#06475f_22%,#7a8d91_53%,#062536_76%,#020812_100%)]">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_35%_72%,rgba(255,255,255,0.28),transparent_0.18rem),radial-gradient(circle_at_34.5%_72.4%,rgba(244,179,69,0.8),transparent_0.09rem),radial-gradient(circle_at_79%_61%,rgba(255,255,255,0.22),transparent_0.16rem),linear-gradient(110deg,transparent_0%,rgba(0,0,0,0.18)_62%,rgba(0,0,0,0.62)_100%)]"></div>
        <div class="relative z-10 flex h-screen min-h-0 flex-col px-5 py-4 sm:px-8">
            <div class="flex h-7 justify-end gap-4 text-[#dbe7f6]">
                <span class="text-lg leading-none">↗</span>
                <span class="text-lg leading-none">-</span>
                <span class="text-lg leading-none">□</span>
                <span class="text-lg leading-none">×</span>
            </div>

            @if (_history.Count == 0)
            {
                <section class="mx-auto flex w-full max-w-5xl flex-1 flex-col items-center pt-12 text-center">
                    <h1 class="text-3xl font-semibold tracking-normal text-white sm:text-4xl">Nice to see you, Shariar. What's new?</h1>

                    <div class="mt-9 w-full max-w-[46.5rem] rounded-[1.85rem] border border-[#263653] bg-[#121c31] p-4 text-left ring-2 shadow-[0_22px_65px_rgba(0,0,0,0.28)] ring-[#22314d]">
                        <div class="relative min-w-0">
                            @ComposerInput("text-base", "Message Copilot")
                            @if (HasInlinePath(_input))
                            {
                                <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                                    @HighlightCommandPaths(_input)
                                </p>
                            }

                            @if (ShowDirectorySuggestions)
                            {
                                <div class="absolute top-full right-0 left-0 z-30 mt-3 overflow-hidden rounded-2xl border border-white/10 bg-[#111b2e] shadow-2xl shadow-black/40">
                                    <div class="border-b border-white/10 px-3 py-2 text-xs font-semibold text-[#aab6c9]">@_directorySuggestionTitle</div>
                                    <div class="max-h-64 overflow-y-auto p-1">
                                        @for (var index = 0; index < _directorySuggestions.Count; index++)
                                        {
                                            var suggestionIndex = index;
                                            var suggestion = _directorySuggestions[index];
                                            <button class="@DirectorySuggestionClass(index)"
                                                    type="button"
                                                    @onmousedown:preventDefault
                                                    @onclick="() => SelectDirectorySuggestionAsync(suggestionIndex)">
                                                <span class="flex min-w-0 items-start gap-2">
                                                    <span class="@DirectorySuggestionIconClass(suggestion.Kind)" aria-hidden="true">@DirectoryIcon(suggestion.Kind)</span>
                                                    <span class="min-w-0">
                                                        <span class="block truncate text-xs font-bold">@suggestion.DisplayName</span>
                                                        <span class="block truncate font-mono text-[0.68rem] opacity-75">@DirectorySuggestionPathText(suggestion)</span>
                                                    </span>
                                                </span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <button class="flex size-9 items-center justify-center rounded-full border border-[#2f4161] text-2xl leading-none text-[#d6dfef] transition hover:bg-white/10"
                                        type="button"
                                        title="Add context">
                                    +
                                </button>
                                <span class="rounded-full border border-[#2f4161] px-3 py-2 text-sm font-semibold text-[#d6dfef]">Smart⌄</span>
                            </div>
                            <div class="flex items-center gap-4 text-[#d6dfef]">
                                <span class="text-xl">⌘</span>
                                <span class="text-xl">≋</span>
                                <button class="rounded-full bg-[#d6dfef] px-4 py-2 text-sm font-semibold text-[#101827] transition hover:bg-white disabled:cursor-not-allowed disabled:bg-[#41506d] disabled:text-[#aab6c9]"
                                        type="button"
                                        disabled="@IsSendDisabled"
                                        @onclick="SendAsync">
                                    @(_isBusy ? "Thinking..." : "Send")
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 flex max-w-3xl flex-wrap justify-center gap-2">
                        @foreach (var prompt in StarterPrompts)
                        {
                            <button class="rounded-full border border-[#30445b] bg-[#1e344b]/85 px-4 py-2 text-sm font-semibold text-[#c4cede] shadow-md shadow-black/20 transition hover:bg-[#2c4965]"
                                    type="button"
                                    @onclick="() => UseStarterPrompt(prompt)">
                                @prompt
                            </button>
                        }
                    </div>

                    <div class="mt-auto grid w-full max-w-4xl gap-5 pb-12 lg:grid-cols-2">
                        <section class="rounded-[2rem] bg-[#18263a]/92 p-5 text-left shadow-2xl shadow-black/20">
                            <p class="text-xs font-semibold text-[#aab6c9]">Attach a recent file to chat</p>
                            <div class="mt-3 space-y-2">
                                <div class="rounded-2xl bg-white/8 px-3 py-3 text-sm font-semibold text-[#d9e2f1]">Reports folder request</div>
                                <div class="rounded-2xl px-3 py-3 text-sm font-semibold text-[#d9e2f1]">Restart schedule command</div>
                                <div class="rounded-2xl px-3 py-3 text-sm font-semibold text-[#d9e2f1]">Downloads cleanup plan</div>
                            </div>
                        </section>

                        <section class="rounded-[2rem] bg-[#18263a]/92 p-5 text-left shadow-2xl shadow-black/20">
                            <p class="text-xs font-semibold text-[#aab6c9]">Keep talking to Copilot</p>
                            <div class="mt-3 space-y-2">
                                @foreach (var chat in _chats.Take(3))
                                {
                                    <button class="flex w-full min-w-0 items-center gap-3 rounded-2xl px-2 py-2 text-left text-[#d9e2f1] transition hover:bg-white/8"
                                            type="button"
                                            @onclick="() => SelectChatAsync(chat.Id)">
                                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white/10">
                                            <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                <path d="M5 8.5A3.5 3.5 0 0 1 8.5 5h7A3.5 3.5 0 0 1 19 8.5v4A3.5 3.5 0 0 1 15.5 16H13l-4 3v-3h-.5A3.5 3.5 0 0 1 5 12.5v-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                            </svg>
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm font-semibold">@chat.Title</span>
                                            <span class="block truncate text-xs text-[#aab6c9]">@FormatChatDate(chat.UpdatedAtUtc)</span>
                                        </span>
                                    </button>
                                }
                            </div>
                        </section>
                    </div>
                </section>
            }
            else
            {
                <section class="mx-auto flex w-full max-w-4xl flex-1 flex-col overflow-hidden py-8">
                    <div class="mb-5 flex items-center justify-between">
                        <h1 class="truncate text-xl font-semibold text-white">@ActiveChatTitle</h1>
                        <span class="rounded-full border border-emerald-300/25 bg-emerald-300/10 px-3 py-1 text-xs font-semibold text-emerald-100">Protected execution</span>
                    </div>

                    <div class="min-h-0 flex-1 space-y-5 overflow-y-auto pr-2">
                        @foreach (var item in _history)
                        {
                            <div class="flex justify-end">
                                <div class="user-message-bubble max-w-[82%] overflow-hidden rounded-[1.25rem] rounded-br-md bg-[#dce9ff] px-4 py-3 text-sm text-[#0b1427] shadow-sm [overflow-wrap:anywhere]">@HighlightCommandPaths(item.UserText)</div>
                            </div>
                            <div class="flex justify-start">
                                <div class="max-w-[88%] min-w-0 overflow-hidden rounded-[1.25rem] rounded-bl-md border border-white/10 bg-[#17253a]/95 p-4 text-sm text-[#d9e2f1] shadow-sm">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <p class="text-xs font-semibold tracking-[0.14em] text-[#8fa1bc] uppercase">Requested action</p>
                                            <h2 class="mt-1 text-base font-semibold text-white">@ActionTitle(item.CommandLabel)</h2>
                                        </div>
                                        <span class="@ActionStatusClass(item)">
                                            @ActionStatusText(item)
                                        </span>
                                    </div>
                                    <p class="mt-3 leading-6 text-[#cbd7e8] [overflow-wrap:anywhere]">@FormalAssistantMessage(item)</p>
                                    @if (!string.IsNullOrWhiteSpace(item.ResolvedPath))
                                    {
                                        <div class="mt-4 rounded-xl border border-white/10 bg-black/20 px-3 py-2">
                                            <p class="font-semibold tracking-[0.14em] text-[0.68rem] text-[#8fa1bc] uppercase">Target path</p>
                                            <p class="mt-1 max-w-full font-mono text-xs leading-5 whitespace-pre-wrap text-[#e8f2ff] [overflow-wrap:anywhere]">@item.ResolvedPath</p>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.ExecutionMessage))
                                    {
                                        <div class="mt-3 rounded-xl border border-white/10 bg-black/20 px-3 py-2">
                                            <p class="font-semibold tracking-[0.14em] text-[0.68rem] text-[#8fa1bc] uppercase">Outcome</p>
                                            <p class="mt-1 text-xs font-semibold text-[#e8f2ff] [overflow-wrap:anywhere]">@item.ExecutionMessage</p>
                                        </div>
                                    }
                                    <div class="mt-3 flex flex-wrap gap-2 font-semibold text-[0.7rem] text-[#8fa1bc]">
                                        <span>Confidence @FormatConfidence(item.Confidence)</span>
                                        <span>Source @item.Source</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_pendingCommand is not null)
                    {
                        <section class="@PanelClass">
                            <h2 class="text-base font-semibold">@PanelTitle</h2>
                            <p class="mt-3 text-sm leading-6 [overflow-wrap:anywhere]">@PanelMessage</p>

                            @if (CanEditPendingPath)
                            {
                                <label class="mt-4 block text-xs font-bold tracking-[0.16em] uppercase opacity-75" for="pending-path">Target path</label>
                                <input id="pending-path"
                                       class="mt-2 min-h-11 w-full rounded-xl border border-white/10 bg-black/20 px-3 font-mono text-xs text-white outline-none focus:border-[#8ec5ff] focus:ring-4 focus:ring-[#8ec5ff]/10"
                                       value="@_pendingPathText"
                                       @oninput="OnPendingPathInput"
                                       disabled="@_isExecuting" />
                            }

                            @if (CanExecutePendingCommand)
                            {
                                <div class="mt-4 flex gap-3">
                                    <button class="rounded-xl bg-[#dce9ff] px-4 py-2 text-sm font-semibold text-[#0b1427] transition hover:bg-white disabled:bg-white/20 disabled:text-[#aab6c9]"
                                            disabled="@_isExecuting"
                                            @onclick="RequestCommandConfirmation">@(_isExecuting ? "Running..." : "Confirm")</button>
                                    <button class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10 disabled:opacity-60"
                                            disabled="@_isExecuting"
                                            @onclick="CancelPending">Cancel</button>
                                </div>
                            }
                        </section>
                    }

                    <div class="mt-5 rounded-[1.5rem] border border-[#263653] bg-[#121c31] p-4 shadow-[0_18px_50px_rgba(0,0,0,0.24)]">
                        <div class="flex flex-col gap-3 sm:flex-row">
                            <div class="relative min-w-0 flex-1">
                                @ComposerInput("text-sm", CommandInputPlaceholder)
                                @if (HasInlinePath(_input))
                                {
                                    <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                                        @HighlightCommandPaths(_input)
                                    </p>
                                }
                                @if (ShowDirectorySuggestions)
                                {
                                    <div class="absolute right-0 bottom-full left-0 z-30 mb-2 overflow-hidden rounded-2xl border border-white/10 bg-[#111b2e] shadow-2xl shadow-black/40">
                                        <div class="border-b border-white/10 px-3 py-2 text-xs font-semibold text-[#aab6c9]">@_directorySuggestionTitle</div>
                                        <div class="max-h-64 overflow-y-auto p-1">
                                            @for (var index = 0; index < _directorySuggestions.Count; index++)
                                            {
                                                var suggestionIndex = index;
                                                var suggestion = _directorySuggestions[index];
                                                <button class="@DirectorySuggestionClass(index)"
                                                        type="button"
                                                        @onmousedown:preventDefault
                                                        @onclick="() => SelectDirectorySuggestionAsync(suggestionIndex)">
                                                    <span class="flex min-w-0 items-start gap-2">
                                                        <span class="@DirectorySuggestionIconClass(suggestion.Kind)" aria-hidden="true">@DirectoryIcon(suggestion.Kind)</span>
                                                        <span class="min-w-0">
                                                            <span class="block truncate text-xs font-bold">@suggestion.DisplayName</span>
                                                            <span class="block truncate font-mono text-[0.68rem] opacity-75">@DirectorySuggestionPathText(suggestion)</span>
                                                        </span>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <button class="min-h-12 rounded-2xl bg-[#dce9ff] px-6 text-sm font-semibold text-[#0b1427] transition hover:bg-white disabled:cursor-not-allowed disabled:bg-[#41506d] disabled:text-[#aab6c9]"
                                    disabled="@IsSendDisabled"
                                    @onclick="SendAsync">@(_isBusy ? "Thinking..." : "Send")</button>
                        </div>
                    </div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p class="absolute right-6 bottom-6 left-6 z-20 rounded-xl border border-rose-300/20 bg-rose-950/80 px-3 py-2 text-sm text-rose-100">@_errorMessage</p>
            }
        </div>
    </main>

    @if (_chatPendingDeletion is not null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 backdrop-blur-sm">
            <section class="w-full max-w-md rounded-[1.5rem] border border-white/10 bg-[#101827] p-5 text-[#d9e2f1] shadow-2xl shadow-black/40">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-rose-400/15 text-rose-200">
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M6 7h12m-9 0V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7m-7 0 .7 12h6.6L16 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-lg font-semibold text-white">Delete chat history?</h2>
                        <p class="mt-2 text-sm leading-6 text-[#aab6c9]">
                            This will remove <span class="font-semibold text-white">@_chatPendingDeletion.Title</span> and its saved messages from this device.
                        </p>
                    </div>
                </div>
                <div class="mt-5 flex justify-end gap-3">
                    <button class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white transition hover:bg-white/10"
                            type="button"
                            disabled="@_isDeletingChat"
                            @onclick="CancelDeleteChat">
                        Cancel
                    </button>
                    <button class="rounded-xl bg-rose-400 px-4 py-2 text-sm font-semibold text-[#21080d] transition hover:bg-rose-300 disabled:bg-rose-400/40"
                            type="button"
                            disabled="@_isDeletingChat"
                            @onclick="ConfirmDeleteChatAsync">
                        @(_isDeletingChat ? "Deleting..." : "Delete")
                    </button>
                </div>
            </section>
        </div>
    }

    @if (_showCommandConfirmationModal && _pendingCommand is not null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 px-4 backdrop-blur-sm">
            <section class="w-full max-w-lg rounded-[1.5rem] border border-white/10 bg-[#101827] p-5 text-[#d9e2f1] shadow-2xl shadow-black/40">
                <div class="flex items-start gap-3">
                    <span class="@CommandConfirmationIconClass">
                        <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 9v4m0 4h.01M10.3 4.7 2.9 17.5A1.7 1.7 0 0 0 4.4 20h15.2a1.7 1.7 0 0 0 1.5-2.5L13.7 4.7a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
