        {
            _errorMessage = $"Could not load command history: {ex.Message}";
        }
    }

    private async Task SendAsync()
    {
        var text = BuildCommandText();
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        var activeChatId = _activeChatId;
        if (activeChatId is null)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        _pendingCommand = null;
        _pendingPathText = string.Empty;
        _pendingPathError = null;
        _lastResponse = null;
        _lowConfidenceRequiresConfirmation = false;
        _pendingCommandLogId = null;
        ClearDirectorySuggestions();
        var selectedDirectories = _selectedDirectories.ToArray();

        try
        {
            var response = await AiClient.PredictAsync(text);
            _lastResponse = response;

            _effectiveLabel = response.Confidence < 0.60 ? "unknown" : response.CommandLabel;
            _lowConfidenceRequiresConfirmation = response.Confidence >= 0.60 && response.Confidence < 0.80;
            var requiresConfirmation = response.RequiresConfirmation || _lowConfidenceRequiresConfirmation;
            var parsed = Parser.Parse(_effectiveLabel, text, requiresConfirmation);
            _pendingCommand = parsed;
            _pendingPathText = parsed.ResolvedPath ?? parsed.PathText ?? string.Empty;

            var message = BuildPredictionMessage(response, parsed);
            var historyItem = await CommandHistory.RecordPredictionAsync(
                activeChatId.Value,
                text,
                response,
                parsed,
                _effectiveLabel,
                message,
                _lowConfidenceRequiresConfirmation);

            _history.Add(AssistantHistoryItem.FromCommandHistory(historyItem));
            _pendingCommandLogId = historyItem.Id;
            await RefreshChatsAsync(activeChatId.Value);

            _input = string.Empty;
            _pathTailInput = string.Empty;
            if (selectedDirectories.Length > 0)
            {
                _selectedDirectories.Clear();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_pendingCommand is null || !CanExecutePendingCommand)
        {
            return;
        }

        if (CanEditPendingPath)
        {
            RefreshPendingPath();
            if (_pendingCommand is null || !CanExecutePendingCommand)
            {
                return;
            }

            if (_pendingCommandLogId is Guid pathUpdateLogId)
            {
                var updatedHistory = await CommandHistory.UpdatePlannedTargetAsync(
                    pathUpdateLogId,
                    _pendingCommand,
                    BuildPendingAssistantMessage(_pendingCommand));
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(updatedHistory));
            }
        }

        _isExecuting = true;
        _errorMessage = null;

        try
        {
            var result = await Executor.ExecuteAsync(_pendingCommand, confirmed: true);
            if (_pendingCommandLogId is Guid commandLogId)
            {
                var historyItem = await CommandHistory.RecordExecutionAsync(commandLogId, result);
                ReplaceHistoryItem(AssistantHistoryItem.FromCommandHistory(historyItem));
            }

            _pendingCommand = null;
            _pendingCommandLogId = null;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private async Task RequestCommandConfirmation()
    {
