    private static string FormalAssistantMessage(AssistantHistoryItem item)
    {
        if (item.CommandLabel == "unknown")
        {
            return item.AssistantMessage;
        }

        if (item.ExecutionStatus.Equals("succeeded", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action completed successfully.";
        }

        if (item.ExecutionStatus.Equals("failed", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action could not be completed.";
        }

        if (item.ExecutionStatus.Equals("cancelled", StringComparison.OrdinalIgnoreCase))
        {
            return "The requested action was cancelled.";
        }

        if (item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase))
        {
            return "Review the action details and confirm when you are ready.";
        }

        return "Review the action details before continuing.";
    }

    private static bool ShouldRenderFileDetails(AssistantHistoryItem item)
    {
        return item.CommandLabel == "filesystem.get_file_details"
            && item.ExecutionStatus.Equals("succeeded", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(item.ExecutionMessage);
    }

    private static IReadOnlyList<KeyValuePair<string, string>> ParseFileDetails(string? executionMessage)
    {
        if (string.IsNullOrWhiteSpace(executionMessage))
        {
            return Array.Empty<KeyValuePair<string, string>>();
        }

        var details = new List<KeyValuePair<string, string>>();
        foreach (var line in executionMessage.Split(
            ['\r', '\n'],
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separatorIndex = line.IndexOf(':', StringComparison.Ordinal);
            if (separatorIndex <= 0 || separatorIndex >= line.Length - 1)
            {
                continue;
            }

            var label = line[..separatorIndex].Trim();
            var value = FormatFileDetailValue(label, line[(separatorIndex + 1)..].Trim());
            if (!string.IsNullOrWhiteSpace(label) && !string.IsNullOrWhiteSpace(value))
            {
                details.Add(new KeyValuePair<string, string>(label, value));
            }
        }

        return details;
    }

    private static string FormatFileDetailValue(string label, string value)
    {
        if (!IsFileTimestampDetail(label))
        {
            return value;
        }

        if (DateTimeOffset.TryParse(value, out var timestampWithOffset))
        {
            return timestampWithOffset.ToLocalTime().ToString("MMM d, yyyy, h:mm tt");
        }

        return DateTime.TryParse(value, out var timestamp)
            ? timestamp.ToString("MMM d, yyyy, h:mm tt")
            : value;
    }

    private static bool IsFileTimestampDetail(string label)
    {
        return label.Equals("Created", StringComparison.OrdinalIgnoreCase)
            || label.Equals("Modified", StringComparison.OrdinalIgnoreCase)
            || label.Equals("Accessed", StringComparison.OrdinalIgnoreCase);
    }

    private static string? FindFileDetailValue(IReadOnlyList<KeyValuePair<string, string>> details, string key)
    {
        return details.FirstOrDefault(
            detail => detail.Key.Equals(key, StringComparison.OrdinalIgnoreCase)).Value;
    }

    private static bool IsFeaturedFileDetail(string key)
    {
        return key.Equals("File details", StringComparison.OrdinalIgnoreCase)
            || key.Equals("Name", StringComparison.OrdinalIgnoreCase)
            || key.Equals("Owner", StringComparison.OrdinalIgnoreCase)
            || key.Equals("Size", StringComparison.OrdinalIgnoreCase)
            || key.Equals("Modified", StringComparison.OrdinalIgnoreCase)
            || key.Equals("Attributes", StringComparison.OrdinalIgnoreCase);
    }

    private static string ActionStatusText(AssistantHistoryItem item)
    {
        return item.ExecutionStatus.ToLowerInvariant() switch
        {
            "succeeded" => "Completed",
            "failed" => "Failed",
            "cancelled" => "Cancelled",
            _ when item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase) => "Needs confirmation",
            _ => "Ready",
        };
    }

    private static string ActionStatusClass(AssistantHistoryItem item)
    {
        var baseClass = "rounded-full px-3 py-1 text-xs font-semibold";
        return item.ExecutionStatus.ToLowerInvariant() switch
        {
            "succeeded" => $"{baseClass} bg-emerald-300/15 text-emerald-100 ring-1 ring-emerald-300/25",
            "failed" => $"{baseClass} bg-rose-300/15 text-rose-100 ring-1 ring-rose-300/25",
            "cancelled" => $"{baseClass} bg-slate-300/15 text-slate-100 ring-1 ring-slate-300/25",
            _ when item.AssistantMessage.Contains("confirm", StringComparison.OrdinalIgnoreCase) => $"{baseClass} bg-amber-300/15 text-amber-100 ring-1 ring-amber-300/25",
            _ => $"{baseClass} bg-sky-300/15 text-sky-100 ring-1 ring-sky-300/25",
        };
    }

    private static string FormatConfidence(double confidence)
    {
        return $"{confidence:P0}";
    }

    private static string FormatScheduledFor(DateTimeOffset scheduledForUtc)
    {
        return scheduledForUtc.ToLocalTime().ToString("MMM d, h:mm tt");
    }

    private static string FormatScheduledTaskKind(ScheduledTaskItem task)
    {
        if (IsWebAutomationTask(task))
        {
            return task.RepeatMode == ScheduledTask.WeeklyRepeatMode
                ? "Weekly web flow"
                : "One-time web flow";
        }

        if (!IsMessageAutomationTask(task))
        {
            return "Restart task";
        }

        return task.RepeatMode == ScheduledTask.WeeklyRepeatMode
            ? "Weekly message"
            : "One-time message";
    }

    private static string FormatRecipients(IReadOnlyList<string> recipients)
    {
        return recipients.Count == 0 ? "No recipients" : string.Join(", ", recipients);
    }

    private static string ScheduledTaskCancelText(ScheduledTaskItem task)
    {
        return IsMessageAutomationTask(task) || IsWebAutomationTask(task) ? "Cancel automation" : "Cancel task";
    }

    private static bool IsMessageAutomationTask(ScheduledTaskItem task)
    {
        return task.TaskType == ScheduledTask.MessageAutomationTaskType;
    }

    private static bool IsWebAutomationTask(ScheduledTaskItem task)
    {
        return task.TaskType == ScheduledTask.WebAutomationTaskType;
    }

    private static string FormatScheduledCountdown(ScheduledTaskItem task)
    {
        var remaining = task.ScheduledForUtc - DateTimeOffset.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "Due now";
        }

        return remaining.TotalMinutes >= 1
            ? $"{(int)remaining.TotalMinutes:D2}:{remaining.Seconds:D2}"
            : $"{Math.Max(1, (int)Math.Ceiling(remaining.TotalSeconds))}s";
    }

    private static string ScheduledTaskCountdownClass(ScheduledTaskItem task)
    {
        var remaining = task.ScheduledForUtc - DateTimeOffset.UtcNow;
        var baseClass = "rounded-full px-3 py-1 text-xs font-semibold";
        return remaining <= TimeSpan.FromSeconds(10)
            ? $"{baseClass} bg-amber-300/15 text-amber-100 ring-1 ring-amber-300/25"
            : $"{baseClass} bg-sky-300/10 text-sky-100 ring-1 ring-sky-300/25";
    }

    private static string ScheduledTaskProgressStyle(ScheduledTaskItem task)
    {
        var totalSeconds = Math.Max(1, (task.ScheduledForUtc - task.CreatedAtUtc).TotalSeconds);
        var elapsedSeconds = Math.Clamp(
            (DateTimeOffset.UtcNow - task.CreatedAtUtc).TotalSeconds,
            0,
            totalSeconds);
        var percentage = elapsedSeconds / totalSeconds * 100;
        return $"width: {percentage:F0}%";
    }

    private static string ConfidenceClass(double confidence)
    {
        if (confidence < 0.60)
        {
            return "rounded-full bg-rose-100 px-2 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-400/[0.12] dark:text-rose-200";
        }

        if (confidence < 0.80)
        {
            return "rounded-full bg-amber-100 px-2 py-1 text-xs font-semibold text-amber-700 dark:bg-amber-400/[0.12] dark:text-amber-200";
        }

        return "rounded-full bg-emerald-100 px-2 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-400/[0.12] dark:text-emerald-200";
    }

    private sealed class MessageListMetrics
    {
        public double ScrollTop { get; set; }

        public double ScrollHeight { get; set; }

        public double ClientHeight { get; set; }
    }

    public void Dispose()
    {
        _scheduledTaskTimer?.Dispose();
        _directoryPickerReference?.Dispose();
    }

    private void ReplaceHistoryItem(AssistantHistoryItem item)
    {
        var index = _history.FindIndex(existingItem => existingItem.Id == item.Id);
        if (index >= 0)
        {
            _history[index] = item;
            return;
        }

        _history.Add(item);
    }

}


