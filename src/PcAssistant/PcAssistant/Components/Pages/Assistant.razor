    private static string BuildPendingAssistantMessage(ParsedCommand command)
    {
        if (command.IsDangerous)
        {
            return command.ErrorMessage ?? "This command was blocked for safety.";
        }

        return command.RequiresConfirmation
            ? $"Please confirm before running. {command.Preview}"
            : command.Preview;
    }

    private static string BuildPredictionMessage(CommandResponse response, ParsedCommand parsed)
    {
        if (response.Confidence < 0.60 || parsed.CommandLabel == "unknown")
        {
            return "I could not understand this as a PC command. Please rephrase it.";
        }

        if (parsed.IsDangerous)
        {
            return parsed.ErrorMessage ?? "This command was blocked for safety.";
        }

        if (response.Confidence < 0.80)
        {
            return $"Low confidence prediction. Please confirm before running. {parsed.Preview}";
        }

        return parsed.RequiresConfirmation
            ? $"Please confirm before running. {parsed.Preview}"
            : parsed.Preview;
    }

