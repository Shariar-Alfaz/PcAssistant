    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _directoryPickerReference = DotNetObjectReference.Create(this);
        }

        if (_directoryPickerReference is not null)
        {
            await JsRuntime.InvokeVoidAsync(
                "pcAssistantDirectoryPicker.bind",
                CommandInputId,
                _directoryPickerReference);
        }

