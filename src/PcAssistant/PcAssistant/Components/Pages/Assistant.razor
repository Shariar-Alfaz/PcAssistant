    private AssistantDirectoryTrigger? FindDirectoryTrigger()
    {
        var input = ActiveMentionInput;
        var directoryIndex = input.LastIndexOf("@dir:", StringComparison.OrdinalIgnoreCase);
        var folderIndex = input.LastIndexOf("@folder:", StringComparison.OrdinalIgnoreCase);
        var mentionIndex = FindLastLocationMentionIndex(input);

        if (directoryIndex < 0 && folderIndex < 0 && mentionIndex < 0)
        {
            return null;
        }

        var token = "@";
        var index = mentionIndex;
        if (directoryIndex >= index)
        {
            token = "@dir:";
            index = directoryIndex;
        }

        if (folderIndex >= index)
        {
            token = "@folder:";
            index = folderIndex;
        }

        var query = input[(index + token.Length)..].Trim();
        return new AssistantDirectoryTrigger(index, token, query);
    }

    private string ActiveMentionInput => _selectedDirectories.Count == 0 ? _input : _pathTailInput;

    private void ClearTriggerInput(AssistantDirectoryTrigger? trigger, bool hadSelectedDirectories)
    {
        if (trigger is null)
        {
            return;
        }

        if (!hadSelectedDirectories)
        {
            _input = _input[..trigger.Value.Index].TrimEnd();
            return;
        }

        _pathTailInput = _pathTailInput[..trigger.Value.Index].TrimStart();
    }

    private static int FindLastLocationMentionIndex(string input)
    {
        for (var index = input.Length - 1; index >= 0; index--)
        {
            if (input[index] != '@')
            {
                continue;
            }

            if (index > 0 && !char.IsWhiteSpace(input[index - 1]))
            {
                continue;
            }

            return index;
        }

        return -1;
    }

