            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private async Task OnScheduledTaskTimerTickAsync()
    {
        if (_scheduledTasks.Any(task => task.ScheduledForUtc <= DateTimeOffset.UtcNow))
        {
            await RefreshScheduledTasksAsync();
        }

        StateHasChanged();
    }

