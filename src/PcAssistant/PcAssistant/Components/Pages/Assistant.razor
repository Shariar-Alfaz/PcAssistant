    private async Task OnCommandInputAsync(ChangeEventArgs args)
    {
        _input = args.Value?.ToString() ?? string.Empty;
        await RefreshDirectorySuggestionsAsync();
    }

    private async Task OnPathTailInputAsync(ChangeEventArgs args)
    {
        _pathTailInput = args.Value?.ToString() ?? string.Empty;
        await RefreshDirectorySuggestionsAsync();
    }

    private async Task RefreshDirectorySuggestionsAsync()
    {
        var trigger = FindDirectoryTrigger();
        if (trigger is null)
        {
            ClearDirectorySuggestions();
            return;
        }

        IReadOnlyList<DirectorySuggestion> suggestions;
        var currentPath = CurrentSelectedDirectoryPath;
        if (!string.IsNullOrWhiteSpace(currentPath)
            && trigger.Value.Token.Equals("@folder:", StringComparison.OrdinalIgnoreCase))
        {
            var queryPath = string.IsNullOrWhiteSpace(trigger.Value.Query)
                ? currentPath
                : Path.Combine(currentPath, trigger.Value.Query);
            suggestions = (await DirectorySuggestions.SuggestAsync(queryPath, 32))
                .Where(suggestion => !PathsEqual(suggestion.Path, currentPath))
                .Select(suggestion => suggestion with { Kind = "folder" })
                .ToArray();
            _directorySuggestionTitle = "Folders";
        }
        else if (!string.IsNullOrWhiteSpace(currentPath)
            && !trigger.Value.Token.Equals("@dir:", StringComparison.OrdinalIgnoreCase))
        {
            suggestions = await DirectorySuggestions.SuggestChildrenAsync(currentPath, trigger.Value.Query, 32);
            _directorySuggestionTitle = $"Inside {FormatLocationName(currentPath)}";
        }
        else
        {
            suggestions = await DirectorySuggestions.SuggestAsync(trigger.Value.Query, 32);
            _directorySuggestionTitle = "Locations";
        }

        _directorySuggestions.Clear();
        _directorySuggestions.Add(PickLocationSuggestion);
        _directorySuggestions.AddRange(suggestions);
        _selectedDirectoryIndex = _directorySuggestions.Count > 0 ? 0 : -1;
        _showDirectorySuggestions = _directorySuggestions.Count > 0;
    }

    [JSInvokable]
    public async Task<bool> HandleDirectoryPickerKeyAsync(string key)
    {
        if (!ShowDirectorySuggestions)
        {
            return false;
        }

        switch (key)
        {
            case "ArrowDown":
                _selectedDirectoryIndex = Math.Min(_selectedDirectoryIndex + 1, _directorySuggestions.Count - 1);
                StateHasChanged();
                return true;
            case "ArrowUp":
                _selectedDirectoryIndex = Math.Max(_selectedDirectoryIndex - 1, 0);
                StateHasChanged();
                return true;
            case "Tab":
            case "Enter":
                await SelectDirectorySuggestionAsync(_selectedDirectoryIndex < 0 ? 0 : _selectedDirectoryIndex);
                return true;
            case "Escape":
                ClearDirectorySuggestions();
                StateHasChanged();
                return true;
            default:
                return false;
        }
    }

    private async Task SelectDirectorySuggestionAsync(int index)
    {
        if (index < 0 || index >= _directorySuggestions.Count)
        {
            return;
        }

        var trigger = FindDirectoryTrigger();
        var hadSelectedDirectories = _selectedDirectories.Count > 0;
        var selectedDirectory = _directorySuggestions[index];
        if (selectedDirectory.Kind == PickLocationKind)
        {
            var pickedLocation = await LocationPicker.PickDirectoryAsync();
            if (pickedLocation is null)
            {
                ClearDirectorySuggestions();
                StateHasChanged();
                return;
            }

            _selectedDirectories.Clear();
            _selectedDirectories.Add(pickedLocation);
        }
        else if (!string.IsNullOrWhiteSpace(CurrentSelectedDirectoryPath)
            && trigger?.Token.Equals("@dir:", StringComparison.OrdinalIgnoreCase) != true)
        {
            _selectedDirectories.Add(selectedDirectory);
        }
        else
        {
            _selectedDirectories.Clear();
            _selectedDirectories.Add(selectedDirectory);
        }

        ClearTriggerInput(trigger, hadSelectedDirectories);
        _focusCommandInputAfterRender = true;

        ClearDirectorySuggestions();
        StateHasChanged();
    }

    private async Task LoadChatsAsync()
    {
        _isLoadingChats = true;
        _chats.Clear();

        var chats = await CommandHistory.ListChatsAsync();
        _chats.AddRange(chats);

        if (_chats.Count == 0)
        {
            var newChat = await CommandHistory.CreateChatAsync();
            _chats.Add(newChat);
        }

        await SelectChatAsync(_chats[0].Id);
        _isLoadingChats = false;
    }

    private async Task RefreshChatsAsync(Guid activeChatId)
    {
        var chats = await CommandHistory.ListChatsAsync();
        _chats.Clear();
        _chats.AddRange(chats);
        _activeChatId = activeChatId;
    }

    private async Task NewChatAsync()
    {
        _errorMessage = null;
        var chat = await CommandHistory.CreateChatAsync();
        _chats.Insert(0, chat);
        await SelectChatAsync(chat.Id);
    }

    private async Task SelectChatAsync(Guid chatSessionId)
    {
        _errorMessage = null;
        _pendingCommand = null;
        _pendingCommandLogId = null;
        _pendingPathText = string.Empty;
        _pendingPathError = null;
        _lastResponse = null;
        _lowConfidenceRequiresConfirmation = false;
        _pathTailInput = string.Empty;
        ClearDirectorySuggestions();

        var chat = await CommandHistory.GetChatAsync(chatSessionId);
        _activeChatId = chatSessionId;
        _history.Clear();
        _history.AddRange(chat.Messages.Select(AssistantHistoryItem.FromCommandHistory));

        var existingIndex = _chats.FindIndex(existingChat => existingChat.Id == chatSessionId);
        if (existingIndex >= 0)
        {
            _chats[existingIndex] = chat.Summary;
        }
    }

    private void RequestDeleteChat(Guid chatSessionId)
    {
        _chatPendingDeletion = _chats.FirstOrDefault(chat => chat.Id == chatSessionId);
    }

    private void CancelDeleteChat()
    {
        if (_isDeletingChat)
        {
            return;
        }

        _chatPendingDeletion = null;
    }

    private async Task ConfirmDeleteChatAsync()
    {
        if (_chatPendingDeletion is null)
        {
            return;
        }

        _isDeletingChat = true;
        try
        {
            await DeleteChatAsync(_chatPendingDeletion.Id);
            _chatPendingDeletion = null;
        }
        finally
        {
            _isDeletingChat = false;
        }
    }

    private async Task DeleteChatAsync(Guid chatSessionId)
    {
        _errorMessage = null;
        await CommandHistory.DeleteChatAsync(chatSessionId);
        _chats.RemoveAll(chat => chat.Id == chatSessionId);

        if (_chats.Count == 0)
        {
            var newChat = await CommandHistory.CreateChatAsync();
            _chats.Add(newChat);
        }

        var nextChatId = _activeChatId == chatSessionId
            ? _chats[0].Id
            : _activeChatId ?? _chats[0].Id;
        await SelectChatAsync(nextChatId);
    }

    private void UseStarterPrompt(string prompt)
    {
        _input = prompt;
        _pathTailInput = string.Empty;
    }

    private static bool HasInlinePath(string text)
    {
        return !string.IsNullOrWhiteSpace(text) && InlinePathRegex.IsMatch(text);
    }

    private static MarkupString HighlightCommandPaths(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return new MarkupString(string.Empty);
        }

        var cursor = 0;
        var builder = new System.Text.StringBuilder();
        foreach (System.Text.RegularExpressions.Match match in InlinePathRegex.Matches(text))
        {
            if (match.Index > cursor)
            {
                builder.Append(System.Net.WebUtility.HtmlEncode(text[cursor..match.Index]));
            }

            var path = match.Groups["path"].Value;
            builder
                .Append("<span class=\"inline-path-highlight\">")
                .Append(System.Net.WebUtility.HtmlEncode(path))
                .Append("</span>");
            cursor = match.Index + match.Length;
        }

        if (cursor < text.Length)
        {
            builder.Append(System.Net.WebUtility.HtmlEncode(text[cursor..]));
        }

        return new MarkupString(builder.ToString());
    }

    private string BuildCommandText()
    {
        var commandText = _input.Trim();
        var tailText = _pathTailInput.Trim();
        var selectedPath = CurrentSelectedDirectoryPath;
        if (string.IsNullOrWhiteSpace(selectedPath))
        {
            return string.IsNullOrWhiteSpace(tailText)
                ? commandText
                : $"{commandText} {tailText}".Trim();
        }

        var commandWithPath = string.IsNullOrWhiteSpace(commandText)
            ? selectedPath
            : $"{commandText} {selectedPath}".Trim();

        return string.IsNullOrWhiteSpace(tailText)
            ? commandWithPath
            : $"{commandWithPath} {tailText}".Trim();
    }

    private string? CurrentSelectedDirectoryPath => _selectedDirectories.Count == 0
        ? null
        : _selectedDirectories[^1].Path;

    private void RemoveSelectedDirectory(int index)
    {
        if (index < 0 || index >= _selectedDirectories.Count)
        {
            return;
        }

        _selectedDirectories.RemoveRange(index, _selectedDirectories.Count - index);
        if (_selectedDirectories.Count == 0)
        {
            _pathTailInput = string.Empty;
        }
    }

    private string DirectorySuggestionClass(int index)
    {
        var selectedClasses = index == _selectedDirectoryIndex
            ? "bg-[#26364f] text-[#d8ecff]"
            : "text-[#c4cede] hover:bg-white/[0.08]";

        return $"block w-full rounded-xl px-2.5 py-1.5 text-left transition {selectedClasses}";
    }

    private string ChatRowClass(Guid chatSessionId)
    {
        var selectedClasses = chatSessionId == _activeChatId
            ? "bg-white/[0.08] text-white"
            : "text-[#d8deeb] hover:bg-white/[0.06] hover:text-white";

        return $"group flex min-w-0 items-center gap-2 rounded-lg px-2 py-2 text-sm font-semibold transition {selectedClasses}";
    }

    private static string FormatChatDate(DateTimeOffset value)
    {
        var local = value.ToLocalTime();
        var today = DateTimeOffset.Now.Date;
        if (local.Date == today)
        {
            return local.ToString("h:mm tt");
        }

        if (local.Date == today.AddDays(-1))
        {
            return "Yesterday";
        }

        return local.ToString("MMM d");
    }

