@page "/"

<PageTitle>PcAssistant</PageTitle>

<section class="flex min-h-[calc(100vh-7rem)] items-center justify-center">
    <div class="w-full max-w-3xl px-2 text-center">
        <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-[#0f6cbd] text-base font-semibold text-white shadow-sm">PA</div>
        <h1 class="mt-6 text-3xl font-semibold tracking-normal text-slate-950 dark:text-white sm:text-4xl">What can I help you do on this PC?</h1>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-neutral-300">
            Ask for a local action, review the detected command, then confirm anything sensitive before it runs.
        </p>
        <a href="assistant" class="mx-auto mt-8 flex min-h-14 max-w-2xl items-center justify-between rounded-[1.5rem] border border-slate-200 bg-white px-5 text-left text-sm text-slate-500 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 dark:border-white/10 dark:bg-[#2b2b2b] dark:text-neutral-300 dark:hover:bg-[#303030]">
            <span>Message PcAssistant</span>
            <span class="flex size-9 items-center justify-center rounded-full bg-[#0f6cbd] text-white" aria-hidden="true">
                <svg class="size-4" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </span>
        </a>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 dark:border-white/10 dark:bg-white/[0.06] dark:text-neutral-300">Create folders</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 dark:border-white/10 dark:bg-white/[0.06] dark:text-neutral-300">Review confidence</span>
            <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 dark:border-white/10 dark:bg-white/[0.06] dark:text-neutral-300">Confirm execution</span>
        </div>
    </div>
</section>
