@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<section class="rounded-[1.25rem] border border-white/10 bg-[#101d2f]/92 p-4 shadow-xl shadow-black/20">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p class="font-semibold tracking-[0.14em] text-[0.68rem] text-[#8fa1bc] uppercase">Workflow</p>
            <h2 class="mt-1 text-base font-semibold text-white">@Steps.Count step(s)</h2>
        </div>
        <span class="text-xs text-[#8fa1bc]">Drag to reorder</span>
    </div>

    <div id="@ListId" class="mt-4 flex flex-col gap-2" data-web-step-list="true">
        @if (Steps.Count == 0)
        {
            <p class="rounded-xl border border-dashed border-white/10 bg-black/15 px-3 py-5 text-center text-sm text-[#aab6c9]">Add a step from the toolbox.</p>
        }
        else
        {
            @foreach (var step in Steps.OrderBy(step => step.OrderIndex))
            {
                <article class="@StepClass(step)"
                         data-step-id="@step.Id"
                         @onclick="() => OnSelectStep.InvokeAsync(step)">
                    <div class="flex min-w-0 items-start gap-3">
                        <button class="web-automation-step-handle"
                                type="button"
                                title="Drag step"
                                aria-label="Drag step"
                                @onclick:stopPropagation>
                            <span aria-hidden="true" class="web-automation-step-grip"></span>
                        </button>
                        <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-white/10 text-xs font-bold text-white">@step.OrderIndex</span>
                        <div class="min-w-0 flex-1">
                            <h3 class="truncate text-sm font-semibold text-white">@DescriptionOrType(step)</h3>
                            <p class="mt-1 truncate text-xs text-[#8fa1bc]">@StepMeta(step)</p>
                        </div>
                    </div>
                    <div class="mt-3 flex justify-end gap-2">
                        <button class="rounded-lg border border-white/15 bg-white/5 px-2 py-1 text-xs font-semibold text-white transition hover:bg-white/10"
                                type="button"
                                @onclick:stopPropagation
                                @onclick="() => OnDuplicateStep.InvokeAsync(step)">
                            Duplicate
                        </button>
                        <button class="rounded-lg border border-rose-300/20 bg-rose-300/10 px-2 py-1 text-xs font-semibold text-rose-100 transition hover:bg-rose-300/15"
                                type="button"
                                @onclick:stopPropagation
                                @onclick="() => DeleteStepWithAnimationAsync(step)">
                            Delete
                        </button>
                    </div>
                </article>
            }
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<WebAutomationStepDto> Steps { get; set; } = Array.Empty<WebAutomationStepDto>();
    [Parameter] public Guid? SelectedStepId { get; set; }
    [Parameter] public EventCallback<WebAutomationStepDto> OnSelectStep { get; set; }
    [Parameter] public EventCallback<WebAutomationStepDto> OnDeleteStep { get; set; }
    [Parameter] public EventCallback<WebAutomationStepDto> OnDuplicateStep { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Guid>> OnReorderSteps { get; set; }

    private readonly string ListId = $"web-automation-steps-{Guid.NewGuid():N}";
    private DotNetObjectReference<StepList>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _reference ??= DotNetObjectReference.Create(this);
        await JsRuntime.InvokeVoidAsync("pcAssistantWebAutomation.initializeSortableSteps", ListId, _reference);
    }

    [JSInvokable]
    public Task OnStepOrderChanged(string[] stepIds)
    {
        var ids = stepIds.Select(Guid.Parse).ToArray();
        return OnReorderSteps.InvokeAsync(ids);
    }

    private string StepClass(WebAutomationStepDto step)
    {
        return step.Id == SelectedStepId
            ? "web-automation-step-card rounded-xl border border-sky-300/30 bg-sky-300/10 px-3 py-3"
            : "web-automation-step-card rounded-xl border border-white/10 bg-black/20 px-3 py-3 transition hover:bg-white/8";
    }

    private static string StepMeta(WebAutomationStepDto step)
    {
        return string.IsNullOrWhiteSpace(step.Selector)
            ? step.Url ?? step.Value ?? step.StepType.ToString()
            : $"{step.SelectorType}: {step.Selector}";
    }

    private static string DescriptionOrType(WebAutomationStepDto step)
    {
        return string.IsNullOrWhiteSpace(step.Description) ? step.StepType.ToString() : step.Description!;
    }

    public async ValueTask DisposeAsync()
    {
        await JsRuntime.InvokeVoidAsync("pcAssistantWebAutomation.destroySortableSteps", ListId);
        _reference?.Dispose();
    }

    private async Task DeleteStepWithAnimationAsync(WebAutomationStepDto step)
    {
        await JsRuntime.InvokeVoidAsync("pcAssistantWebAutomation.animateStepDeleted", ListId, step.Id.ToString("D"));
        await OnDeleteStep.InvokeAsync(step);
    }
}
