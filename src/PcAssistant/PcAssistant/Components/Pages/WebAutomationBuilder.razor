    private async Task ReorderStepsAsync(IReadOnlyList<Guid> stepIds)
    {
        if (_flow is null)
        {
            return;
        }

        ApplyLocalStepOrder(stepIds);
        StateHasChanged();

        var result = await Projects.ReorderStepsAsync(
            new ReorderWebAutomationStepsRequest(_flow.Id, stepIds),
            _componentCancellation.Token);
        SetMessage(result.Succeeded ? "Step order saved." : result.ErrorMessage);
        if (result.Succeeded && result.Value is not null)
        {
            _steps.Clear();
            _steps.AddRange(result.Value);
            var savedStepIds = _steps.OrderBy(step => step.OrderIndex).Select(step => step.Id.ToString("D")).ToArray();
            _selectedStep = _selectedStep is null
                ? _steps.FirstOrDefault()
                : _steps.FirstOrDefault(step => step.Id == _selectedStep.Id) ?? _steps.FirstOrDefault();
            StateHasChanged();
            await JsRuntime.InvokeVoidAsync("pcAssistantWebAutomation.syncStepDomOrder", _componentCancellation.Token, savedStepIds);
            await JsRuntime.InvokeVoidAsync("pcAssistantWebAutomation.animateStepOrderSaved", _componentCancellation.Token);
            return;
        }

        await LoadAsync(preserveDraft: true);
    }

    private void ApplyLocalStepOrder(IReadOnlyList<Guid> stepIds)
    {
        var stepsById = _steps.ToDictionary(step => step.Id);
        if (stepIds.Count != _steps.Count || stepIds.Any(id => !stepsById.ContainsKey(id)))
        {
            return;
        }

        _steps.Clear();
        for (var index = 0; index < stepIds.Count; index++)
        {
            _steps.Add(stepsById[stepIds[index]] with { OrderIndex = index + 1 });
        }

        _selectedStep = _selectedStep is null
            ? _steps.FirstOrDefault()
            : _steps.FirstOrDefault(step => step.Id == _selectedStep.Id) ?? _steps.FirstOrDefault();
    }

