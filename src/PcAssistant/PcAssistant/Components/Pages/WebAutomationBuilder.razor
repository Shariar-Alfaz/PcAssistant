    private static int ParseInt(object? value, int fallback)
    {
        return int.TryParse(value?.ToString(), out var parsed) ? parsed : fallback;
    }

    private DateTimeOffset BuildScheduleTime()
    {
        if (!TimeOnly.TryParse(_scheduleTimeText, out var time))
        {
            throw new InvalidOperationException("Choose a valid automation time.");
        }

        var date = DateOnly.TryParse(_scheduleDateText, out var parsedDate) ? parsedDate : DateOnly.FromDateTime(DateTime.Now);
        return new DateTimeOffset(date.ToDateTime(time), DateTimeOffset.Now.Offset);
    }

    private static int DayMask(DayOfWeek dayOfWeek)
    {
        return 1 << (int)dayOfWeek;
    }

    private static bool IsQueued(ScheduledTaskItem task)
    {
        return string.Equals(task.QueueStatus, ScheduledTask.QueuedStatus, StringComparison.OrdinalIgnoreCase);
    }

    private static string FormatSchedule(ScheduledTaskItem task)
    {
        return task.ScheduledForUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt");
    }

    private static string FormatRepeat(ScheduledTaskItem task)
    {
        return task.RepeatMode == ScheduledTask.WeeklyRepeatMode ? "Weekly" : "One time";
    }

    private static string FormatStatus(ScheduledTaskItem task)
    {
        return task.QueueStatus switch
        {
            ScheduledTask.QueuedStatus => $"Queued #{task.QueuePosition}",
            ScheduledTask.CompletedStatus => "Completed",
            ScheduledTask.CancelledStatus => "Cancelled",
            ScheduledTask.FailedStatus => "Failed",
            _ => task.QueueStatus,
        };
    }

    private static string StatusClass(ScheduledTaskItem task)
    {
        return task.QueueStatus switch
        {
            ScheduledTask.QueuedStatus => "rounded-full border border-sky-300/20 bg-sky-300/10 px-3 py-1 text-xs font-semibold text-sky-100",
            ScheduledTask.CompletedStatus => "rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-xs font-semibold text-emerald-100",
            ScheduledTask.CancelledStatus => "rounded-full border border-amber-300/20 bg-amber-300/10 px-3 py-1 text-xs font-semibold text-amber-100",
            ScheduledTask.FailedStatus => "rounded-full border border-rose-300/20 bg-rose-300/10 px-3 py-1 text-xs font-semibold text-rose-100",
            _ => "rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-white",
        };
    }

    private static string StepLabel(WebAutomationStepType type) => type switch
    {
        WebAutomationStepType.GotoUrl => "Open URL",
        WebAutomationStepType.WaitForSelector => "Wait for element",
        WebAutomationStepType.ExtractText => "Extract text",
