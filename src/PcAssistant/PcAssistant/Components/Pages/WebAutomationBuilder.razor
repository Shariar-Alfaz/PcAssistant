    private async Task ShowScreenshotPreviewAsync(string? screenshotPath)
    {
        _previewScreenshotPath = string.IsNullOrWhiteSpace(screenshotPath)
            ? null
            : screenshotPath;
        _previewScreenshotDataUri = null;
        _previewScreenshotError = null;

        if (_previewScreenshotPath is null)
        {
            return;
        }

        _isLoadingScreenshotPreview = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (!File.Exists(_previewScreenshotPath))
            {
                _previewScreenshotError = "The captured screenshot file could not be found.";
                return;
            }

            var bytes = await File.ReadAllBytesAsync(_previewScreenshotPath, _componentCancellation.Token);
            _previewScreenshotDataUri = $"data:{GetImageMimeType(_previewScreenshotPath)};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or NotSupportedException or PathTooLongException)
        {
            _previewScreenshotError = $"The screenshot preview could not be loaded: {ex.Message}";
        }
        finally
        {
            _isLoadingScreenshotPreview = false;
        }
    }

    private void CloseScreenshotPreview()
    {
        _previewScreenshotPath = null;
        _previewScreenshotDataUri = null;
        _previewScreenshotError = null;
        _isLoadingScreenshotPreview = false;
    }

